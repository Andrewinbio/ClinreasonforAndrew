    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002000 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002000">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000067"/>
        <obo:IAO_0000115>A modifier of a clinical association</obo:IAO_0000115>
        <obo:IAO_0000232>Analogous to RO:0000053 (has characteristic) in that the association bears the qualifier, but not declared as a sub-property because BFO type constraints require the bearer to be an independent continuant and the characteristic to be a specifically dependent continuant. CLCO associations are information content entities and qualifiers are not modeled as BFO dependent continuants.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0002000</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLE:

&quot;A soft-tissue tumor was suspected.&quot;
SOURCE: &quot;soft-tissue tumor&quot; =&gt; finding
TARGET: &quot;suspected&quot; =&gt; uncertainty
RELATION: SOURCE =&gt; has association qualifier =&gt; TARGET

&quot;The patient denied having a fever.&quot;
SOURCE: &quot;fever&quot; =&gt; finding
TARGET: &quot;denied&quot; =&gt; negation status
RELATION: SOURCE =&gt; has association qualifier =&gt; TARGET

&quot;The biopsy was completed.&quot;
SOURCE: &quot;biopsy&quot; =&gt; intervention
TARGET: &quot;completed&quot; =&gt; completion status
RELATION: SOURCE =&gt; has association qualifier =&gt; TARGET

NEGATIVE EXAMPLES:

&quot;A soft-tissue tumor was suspected.&quot;
Use: has uncertainty status, NOT the generic has association qualifier when a specific subproperty applies.

&quot;The patient denied having a fever.&quot;
Use: has negation status, NOT the generic has association qualifier.

&quot;The biopsy was completed.&quot;
Use: has completion status, NOT the generic has association qualifier.

Use a specific subproperty when one exists, such as has uncertainty status, has negation status, or has completion status.</obo:IAO_0000112>
        <rdfs:label>has association qualifier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002002">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0003000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000060"/>
        <obo:IAO_0000115>Relates a clinical association to its intention qualifier, indicating that the association is intended rather than actual.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0002002</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;The patient will start chemotherapy.&quot;
SOURCE: &quot;chemotherapy&quot; =&gt; intervention
TARGET: &quot;will start&quot; =&gt; intention
RELATION: SOURCE =&gt; has intention =&gt; TARGET

&quot;The patient intended to undergo surgery.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention
TARGET: &quot;intended&quot; =&gt; intention
RELATION: SOURCE =&gt; has intention =&gt; TARGET

NEGATIVE EXAMPLE:

&quot;The patient underwent surgery.&quot;
&quot;underwent&quot; describes an actual event, NOT intention.</obo:IAO_0000112>
        <rdfs:label>has intention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002003">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0003000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000062"/>
        <obo:IAO_0000115>Relates a clinical association to its recommendation qualifier, indicating that the association represents a clinical recommendation.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0002003</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;The physician recommended an MRI.&quot;
SOURCE: &quot;MRI&quot; =&gt; intervention
TARGET: &quot;recommended&quot; =&gt; recommended
RELATION: SOURCE =&gt; has recommended =&gt; TARGET

&quot;The patient should follow up in two weeks.&quot;
SOURCE: &quot;follow up&quot; =&gt; intervention
TARGET: &quot;should&quot; =&gt; recommended
RELATION: SOURCE =&gt; has recommended =&gt; TARGET

NEGATIVE EXAMPLE:

&quot;The patient underwent an MRI.&quot;
&quot;underwent&quot; describes an actual intervention, NOT a recommendation.</obo:IAO_0000112>
        <rdfs:label>has recommended</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002004">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000080"/>
        <obo:IAO_0000115>Relates a clinical association to its negation status, indicating whether the asserted relationship is negated.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0002004</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;The patient denied having a fever.&quot;
SOURCE: &quot;fever&quot; =&gt; finding
TARGET: &quot;denied&quot; =&gt; negation status
RELATION: SOURCE =&gt; has negation status =&gt; TARGET

&quot;No evidence of pneumonia was found.&quot;
SOURCE: &quot;pneumonia&quot; =&gt; finding
TARGET: &quot;no evidence&quot; =&gt; negation status
RELATION: SOURCE =&gt; has negation status =&gt; TARGET

NEGATIVE EXAMPLES:

&quot;A soft-tissue tumor was suspected.&quot;
Use: has uncertainty status, NOT has negation status.

&quot;The patient had severe chest pain.&quot;
&quot;severe&quot; describes severity, NOT negation.</obo:IAO_0000112>
        <rdfs:label>has negation status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002009 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002009">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000081"/>
        <obo:IAO_0000115>Relates a clinical association to its uncertainty qualifier, indicating that the asserted relationship is uncertain or suspected.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0002009</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;Soft-tissue tumor&quot; =&gt; &quot;suspected&quot;
RELATION: &quot;soft-tissue tumor&quot; =&gt; has uncertainty status =&gt; &quot;suspected&quot;

&quot;Pneumonia&quot; =&gt; &quot;possible&quot;
RELATION: &quot;pneumonia&quot; =&gt; has uncertainty status =&gt; &quot;possible&quot;

&quot;Pulmonary embolism&quot; =&gt; &quot;suspected&quot;
RELATION: &quot;pulmonary embolism&quot; =&gt; has uncertainty status =&gt; &quot;suspected&quot;

&quot;Malignancy&quot; =&gt; &quot;probable&quot;
RELATION: &quot;malignancy&quot; =&gt; has uncertainty status =&gt; &quot;probable&quot;

&quot;Viral infection&quot; =&gt; &quot;may&quot;
RELATION: &quot;viral infection&quot; =&gt; has uncertainty status =&gt; &quot;may&quot;

NEGATIVE EXAMPLES:

&quot;Fever&quot; =&gt; &quot;denied&quot;
Use: has negation status, NOT has uncertainty status.

&quot;Biopsy&quot; =&gt; &quot;performed&quot;
Use: has completion status, NOT has uncertainty status.

&quot;Chest pain&quot; =&gt; &quot;severe&quot;
&quot;Severe&quot; describes severity, NOT uncertainty.

&quot;Muscle weakness&quot; =&gt; &quot;worsening&quot;
&quot;Worsening&quot; describes course, NOT uncertainty.

&quot;Hypertension&quot; =&gt; &quot;confirmed&quot;
Do NOT automatically create a has uncertainty status relation for a confirmed diagnosis.

CONTEXTUAL EXAMPLES:

&quot;The physician suspected a soft-tissue tumor.&quot;
SOURCE: &quot;soft-tissue tumor&quot; =&gt; finding
TARGET: &quot;suspected&quot; =&gt; uncertainty
RELATION: SOURCE =&gt; has uncertainty status =&gt; TARGET

&quot;CT findings suggested possible pneumonia.&quot;
SOURCE: &quot;pneumonia&quot; =&gt; finding
TARGET: &quot;possible&quot; =&gt; uncertainty
RELATION: SOURCE =&gt; has uncertainty status =&gt; TARGET

&quot;The patient may have a pulmonary embolism.&quot;
SOURCE: &quot;pulmonary embolism&quot; =&gt; finding
TARGET: &quot;may&quot; =&gt; uncertainty
RELATION: SOURCE =&gt; has uncertainty status =&gt; TARGET

&quot;The clinician recommended a biopsy for a suspected malignancy.&quot;
SOURCE: &quot;malignancy&quot; =&gt; finding
TARGET: &quot;suspected&quot; =&gt; uncertainty
RELATION: SOURCE =&gt; has uncertainty status =&gt; TARGET
Do NOT attach &quot;suspected&quot; to &quot;biopsy&quot;.

&quot;The patient denied having a fever.&quot;
Annotate: &quot;fever&quot; =&gt; finding
Annotate: &quot;denied&quot; =&gt; negation status
Do NOT create a has uncertainty status relation.

&quot;The physician performed a biopsy.&quot;
Annotate: &quot;biopsy&quot; =&gt; intervention
Annotate: &quot;performed&quot; =&gt; completion status
Do NOT create a has uncertainty status relation.</obo:IAO_0000112>
        <rdfs:label>has uncertainty status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002100 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002100">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002000"/>
        <obo:IAO_0000115>Relates a clinical association to a qualifier that modifies a participant (subject or object) rather than the overall statement or predicate.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0002100</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;The patient&apos;s mother has breast cancer.&quot;
SOURCE: &quot;mother&quot; =&gt; family member
TARGET: &quot;patient&apos;s&quot; =&gt; participant qualifier
RELATION: SOURCE =&gt; has participant qualifier =&gt; TARGET

&quot;The patient reported pain in his left knee.&quot;
SOURCE: &quot;knee&quot; =&gt; finding site
TARGET: &quot;his&quot; =&gt; participant qualifier
RELATION: SOURCE =&gt; has participant qualifier =&gt; TARGET

&quot;Her mother reported a history of diabetes.&quot;
SOURCE: &quot;mother&quot; =&gt; family member
TARGET: &quot;her&quot; =&gt; participant qualifier
RELATION: SOURCE =&gt; has participant qualifier =&gt; TARGET

NEGATIVE EXAMPLES:

&quot;A soft-tissue tumor was suspected.&quot;
Use: has uncertainty status, NOT has participant qualifier.

&quot;The physician recommended a biopsy.&quot;
Use: has recommended, NOT has participant qualifier.

&quot;The biopsy was completed.&quot;
Use: has completion status, NOT has participant qualifier.

The qualifier modifies a participant, not the entire clinical statement or predicate.</obo:IAO_0000112>
        <rdfs:label>has participant qualifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002500 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002500">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <obo:IAO_0000115>Relates a clinical association to a clinical entity that participates in it as either the subject or the object.</obo:IAO_0000115>
        <obo:IAO_0000232>Analogous to RO:0000057 (has participant) but not declared as a sub-property because RO:0000057 relates a process (occurrent) to a continuant, whereas CLCO clinical associations are reified information content entities (subClassOf IAO:0000030), not processes. CLCO uses a statement reification pattern (n-ary relation) in which subject and object slots connect an association class to the entities it asserts a relationship between. This pattern has no direct equivalent in RO, which models relations as direct object properties between BFO-typed instances.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0002500</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES: &quot;The patient has pneumonia&quot;, &quot;The MRI showed a mass&quot;, &quot;Surgery was recommended&quot; all contain clinical association participants.
NEGATIVE EXAMPLES: &quot;patient&quot; alone, &quot;pneumonia&quot; alone, and &quot;quickly&quot; do not assert an association participant.
CONTEXTUAL EXAMPLES: In &quot;The patient has pneumonia&quot;, the association has participants patient and pneumonia; in &quot;The MRI showed a mass&quot;, it has MRI and mass; in &quot;Surgery was recommended&quot;, it has surgery.</obo:IAO_0000112>
        <rdfs:label>has association participant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002501 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002501">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002500"/>
        <obo:IAO_0000115>Relates a clinical association (an asserted statement) to the entity that occupies the object position in that association.</obo:IAO_0000115>
        <obo:IAO_0000232>No direct RO equivalent exists. This property fills the object slot in a reified clinical statement (n-ary relation pattern). RO models relations as direct object properties, not as reified statements with named participant slots. See parent property CLCO:0002500 for further rationale.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0002501</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES: In &quot;The patient has pneumonia&quot;, pneumonia is the object; in &quot;The patient received antibiotics&quot;, antibiotics is the object; in &quot;The pain is severe&quot;, severe is the object.
NEGATIVE EXAMPLES: patient, received, and the are respectively subject, predicate, and determiner rather than objects.
CONTEXTUAL EXAMPLES: Record OBJECT pneumonia for &quot;The patient has pneumonia&quot;, OBJECT antibiotics for &quot;The patient received antibiotics&quot;, and OBJECT severe for &quot;The pain is severe&quot;.</obo:IAO_0000112>
        <rdfs:label>has object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002502 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002502">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002500"/>
        <obo:IAO_0000115>Relates a clinical association (an asserted statement) to the entity that occupies the subject position in that association.</obo:IAO_0000115>
        <obo:IAO_0000232>No direct RO equivalent exists. This property fills the subject slot in a reified clinical statement (n-ary relation pattern). RO models relations as direct object properties, not as reified statements with named participant slots. See parent property CLCO:0002500 for further rationale.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0002502</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES: In &quot;The patient has pneumonia&quot;, patient is the subject; in &quot;The MRI showed a mass&quot;, MRI is the subject; in &quot;The pain is severe&quot;, pain is the subject.
NEGATIVE EXAMPLES: pneumonia, mass, and severe are objects in those statements, not subjects.
CONTEXTUAL EXAMPLES: Record SUBJECT patient, MRI, and pain for the three corresponding statements above.</obo:IAO_0000112>
        <rdfs:label>has subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002603 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002603">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000082"/>
        <obo:IAO_0000115>Relates a clinical association to its temporal frame value (historical, current, future, or hypothetical) indicating when the association holds relative to the clinical document.</obo:IAO_0000115>
        <obo:IAO_0000232>Not a sub-property of RO:0002222 (temporally related to) because RO temporal relations use Allen interval algebra to order two occurrents (processes) relative to each other, whereas CLCO temporal frame is a categorical document-relative qualifier (historical/current/future/hypothetical) attached to a reified information entity. The RO_0001900 (temporal interpretation) annotation is retained to indicate that this property has temporal semantics.</obo:IAO_0000232>
        <obo:RO_0001900 rdf:resource="http://purl.obolibrary.org/obo/RO_0001901"/>
        <oboInOwl:hasDbXref>biolink:temporal_context_qualifier</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0002603</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;The patient had pneumonia last year.&quot;
SOURCE: &quot;pneumonia&quot; =&gt; finding
TARGET: &quot;last year&quot; =&gt; temporal frame
RELATION: SOURCE =&gt; has temporal frame =&gt; TARGET

&quot;The patient will undergo surgery tomorrow.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention
TARGET: &quot;tomorrow&quot; =&gt; temporal frame
RELATION: SOURCE =&gt; has temporal frame =&gt; TARGET

NEGATIVE EXAMPLE:

&quot;The patient has had headaches for three weeks.&quot;
&quot;three weeks&quot; describes duration, NOT the document-relative temporal frame.</obo:IAO_0000112>
        <rdfs:label>has temporal frame</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0002222"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002604 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002604">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0003000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000063"/>
        <obo:IAO_0000115>Relates a clinical association to its workflow completion status (pending, in_progress, or completed). Orthogonal to temporal frame and intention.</obo:IAO_0000115>
        <obo:IAO_0000232>Not a sub-property of has_temporal_context because completion status is not a temporal concept. A pending process may be temporally past (labs drawn yesterday, results pending).</obo:IAO_0000232>
        <obo:RO_0001900 rdf:resource="http://purl.obolibrary.org/obo/RO_0001901"/>
        <oboInOwl:id>CLCO:0002604</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:

&quot;The CT results are pending.&quot;
SOURCE: &quot;CT results&quot; =&gt; finding
TARGET: &quot;pending&quot; =&gt; completion status
RELATION: SOURCE =&gt; has completion status =&gt; TARGET

&quot;The biopsy was completed.&quot;
SOURCE: &quot;biopsy&quot; =&gt; intervention
TARGET: &quot;completed&quot; =&gt; completion status
RELATION: SOURCE =&gt; has completion status =&gt; TARGET

NEGATIVE EXAMPLE:

&quot;The patient will undergo a biopsy.&quot;
&quot;will undergo&quot; indicates intention or future temporal frame, NOT completion status.</obo:IAO_0000112>
        <rdfs:label>has completion status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0003000 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0003000">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002000"/>
        <obo:IAO_0000115>Relates a clinical association to a statement-level qualifier that modifies the entire assertion, such as intention, recommendation, or completion status.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0003000</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLE:

&quot;The physician recommended a biopsy.&quot;
SOURCE: &quot;biopsy&quot; =&gt; intervention
TARGET: &quot;recommended&quot; =&gt; statement qualifier
RELATION: SOURCE =&gt; has statement qualifier =&gt; TARGET

&quot;The patient intends to begin physical therapy.&quot;
SOURCE: &quot;physical therapy&quot; =&gt; intervention
TARGET: &quot;intends&quot; =&gt; statement qualifier
RELATION: SOURCE =&gt; has statement qualifier =&gt; TARGET

&quot;The CT results are pending.&quot;
SOURCE: &quot;CT results&quot; =&gt; finding
TARGET: &quot;pending&quot; =&gt; statement qualifier
RELATION: SOURCE =&gt; has statement qualifier =&gt; TARGET

NEGATIVE EXAMPLES:

&quot;The patient&apos;s mother has breast cancer.&quot;
Use: has participant qualifier for a qualifier modifying a participant, NOT has statement qualifier.

&quot;The patient reported pain in his left knee.&quot;
Use: has participant qualifier for a qualifier modifying a participant, NOT has statement qualifier.

&quot;The patient has had headaches for three weeks.&quot;
Use: has temporal frame or a duration representation as appropriate, NOT has statement qualifier for the time expression alone.

Use a specific subproperty when one exists, such as has intention, has recommended, or has completion status. Statement qualifiers modify the entire assertion.</obo:IAO_0000112>
        <rdfs:label>has statement qualifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002700 -->

    <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002700">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <obo:IAO_0000115>The point in time at which the clinical association begins to hold.</obo:IAO_0000115>
        <obo:IAO_0000232>Complements (does not replace) the reified temporal association has_onset (CLCO_0000022). Use this data property for computable timestamps from structured EHR data or normalized NLP output; use has_onset when the temporal expression itself is extracted from narrative text and needs its own qualifiers.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0002700</oboInOwl:id>
        <rdfs:label>has start time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002701 -->

    <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002701">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <obo:IAO_0000115>The point in time at which the clinical association ceases to hold.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0002701</oboInOwl:id>
        <rdfs:label>has end time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0002702 -->

    <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0002702">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <obo:IAO_0000115>The ISO 8601 duration for which the clinical association holds.</obo:IAO_0000115>
        <obo:IAO_0000232>Complements (does not replace) the reified temporal association has_duration (CLCO_0000053). Use this data property for computable duration values; use has_duration when the duration expression needs its own qualifiers.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0002702</oboInOwl:id>
        <rdfs:label>has duration value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <obo:IAO_0000115>An entity is anything that exists or has existed or will exist.</obo:IAO_0000115>
        <obo:IAO_0000112>POSITIVE EXAMPLES: patient, pneumonia, and MRI are entities.
NEGATIVE EXAMPLES: quickly, because, and was are not entities.
CONTEXTUAL EXAMPLES: In &quot;The patient has pneumonia&quot;, patient and pneumonia are entities; in &quot;The MRI showed a mass&quot;, MRI and mass are entities.</obo:IAO_0000112>
        <rdfs:label>entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000002">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000058"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000115>Destination of patient transference</obo:IAO_0000115>
        <oboInOwl:hasDbXref>LOINC:LP203270-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:1014654</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000002</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;transferred to the ICU&quot; =&gt; is transferred to
&quot;sent to the rehabilitation unit&quot; =&gt; is transferred to
&quot;moved to the operating room&quot; =&gt; is transferred to

NEGATIVE EXAMPLES:
&quot;admitted to the ICU&quot; =&gt; is admitted, NOT is transferred to
&quot;referred to cardiology&quot; =&gt; is referred by, NOT is transferred to
&quot;discharged home&quot; =&gt; is discharged, NOT is transferred to

CONTEXTUAL EXAMPLES:
&quot;The patient was transferred to the ICU.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;ICU&quot; =&gt; setting
RELATION: SOURCE =&gt; is transferred to =&gt; TARGET
&quot;She was sent to the rehabilitation unit.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;rehabilitation unit&quot; =&gt; setting
RELATION: SOURCE =&gt; is transferred to =&gt; TARGET
&quot;He was moved to the operating room.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;operating room&quot; =&gt; setting
RELATION: SOURCE =&gt; is transferred to =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is transferred to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000003">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <obo:IAO_0000115>A clinical process related to tracking administrative responsibilitity.</obo:IAO_0000115>
        <obo:IAO_0000232>Do not instantiate.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000003</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;admitted to the hospital&quot; =&gt; clinical administration
&quot;referred to cardiology&quot; =&gt; clinical administration
&quot;discharged home&quot; =&gt; clinical administration

NEGATIVE EXAMPLES:
&quot;chest pain&quot; =&gt; finding, NOT clinical administration
&quot;MRI&quot; =&gt; intervention, NOT clinical administration
&quot;recommended surgery&quot; =&gt; clinical decision, NOT clinical administration

CONTEXTUAL EXAMPLES:
&quot;The patient was admitted to the hospital.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;admitted to the hospital&quot; =&gt; clinical administration
RELATION: SOURCE =&gt; clinical administration =&gt; TARGET
&quot;She was referred to cardiology.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;referred to cardiology&quot; =&gt; clinical administration
RELATION: SOURCE =&gt; clinical administration =&gt; TARGET
&quot;He was discharged home.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;discharged home&quot; =&gt; clinical administration
RELATION: SOURCE =&gt; clinical administration =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>clinical administration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000005 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000005">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <obo:IAO_0000115>A clinical association representing a decision made during patient care, such as a treatment plan, referral, or diagnostic strategy.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT:306206005</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000005</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;decided to start chemotherapy&quot; =&gt; clinical decision
&quot;plan for surgical repair&quot; =&gt; clinical decision
&quot;decision to order an MRI&quot; =&gt; clinical decision

NEGATIVE EXAMPLES:
&quot;chest pain&quot; =&gt; finding, NOT clinical decision
&quot;MRI&quot; =&gt; intervention, NOT clinical decision
&quot;admitted to the hospital&quot; =&gt; clinical administration, NOT clinical decision

CONTEXTUAL EXAMPLES:
&quot;The team decided to start chemotherapy.&quot;
SOURCE: &quot;team&quot; =&gt; clinician; TARGET: &quot;start chemotherapy&quot; =&gt; intervention
RELATION: SOURCE =&gt; clinical decision =&gt; TARGET
&quot;The plan was for surgical repair.&quot;
SOURCE: &quot;plan&quot; =&gt; clinical decision; TARGET: &quot;surgical repair&quot; =&gt; intervention
RELATION: SOURCE =&gt; clinical decision =&gt; TARGET
&quot;The physician decided to order an MRI.&quot;
SOURCE: &quot;physician&quot; =&gt; clinician; TARGET: &quot;order an MRI&quot; =&gt; intervention
RELATION: SOURCE =&gt; clinical decision =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>clinical decision</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000006 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000006">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <obo:IAO_0000115>A clinical reason explaining the reasoning behind a treatment, intervention, condition or medical statement.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0000006</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;because of persistent pain&quot; =&gt; clinical explanation
&quot;due to concern for infection&quot; =&gt; clinical explanation
&quot;to reduce the risk of recurrence&quot; =&gt; clinical explanation

NEGATIVE EXAMPLES:
&quot;chest pain&quot; =&gt; finding, NOT clinical explanation
&quot;MRI&quot; =&gt; intervention, NOT clinical explanation
&quot;physician&quot; =&gt; clinician, NOT clinical explanation

CONTEXTUAL EXAMPLES:
&quot;The MRI was ordered because of persistent pain.&quot;
SOURCE: &quot;MRI&quot; =&gt; intervention; TARGET: &quot;persistent pain&quot; =&gt; reason
RELATION: SOURCE =&gt; clinical explanation =&gt; TARGET
&quot;Antibiotics were started due to concern for infection.&quot;
SOURCE: &quot;antibiotics&quot; =&gt; intervention; TARGET: &quot;concern for infection&quot; =&gt; reason
RELATION: SOURCE =&gt; clinical explanation =&gt; TARGET
&quot;Surgery was performed to reduce the risk of recurrence.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention; TARGET: &quot;reduce the risk of recurrence&quot; =&gt; reason
RELATION: SOURCE =&gt; clinical explanation =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>clinical explanation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000007 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000007">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000003"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000109"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000108"/>
        <obo:IAO_0000112>upload OSH CT chest pulmonary vein protocol</obo:IAO_0000112>
        <obo:IAO_0000115>A member of the clinical team has a specific action</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4044702</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:129450000</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000007</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;scheduled the procedure&quot; =&gt; has action
&quot;uploaded the record&quot; =&gt; has action
&quot;called the patient&quot; =&gt; has action

NEGATIVE EXAMPLES:
&quot;chest pain&quot; =&gt; finding, NOT has action
&quot;MRI&quot; =&gt; intervention, NOT has action
&quot;physician&quot; =&gt; clinician, NOT has action

CONTEXTUAL EXAMPLES:
&quot;The nurse scheduled the procedure.&quot;
SOURCE: &quot;nurse&quot; =&gt; clinician; TARGET: &quot;scheduled the procedure&quot; =&gt; task
RELATION: SOURCE =&gt; has action =&gt; TARGET
&quot;Staff uploaded the record.&quot;
SOURCE: &quot;staff&quot; =&gt; clinician; TARGET: &quot;uploaded the record&quot; =&gt; task
RELATION: SOURCE =&gt; has action =&gt; TARGET
&quot;The office called the patient.&quot;
SOURCE: &quot;office&quot; =&gt; setting; TARGET: &quot;called the patient&quot; =&gt; task
RELATION: SOURCE =&gt; has action =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000010 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000010">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000058"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000112>Patient admitted to ICU</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that the patient was admitted to a specific setting</obo:IAO_0000115>
        <obo:IAO_0000232>Does not exist in OMOP, admission is specific for inpatients or other facility types.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:32485007</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000010</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;admitted to the hospital&quot; =&gt; is admitted
&quot;admitted to the ICU&quot; =&gt; is admitted
&quot;admitted for observation&quot; =&gt; is admitted

NEGATIVE EXAMPLES:
&quot;transferred to the ICU&quot; =&gt; is transferred to, NOT is admitted
&quot;discharged home&quot; =&gt; is discharged, NOT is admitted
&quot;referred to cardiology&quot; =&gt; is referred by, NOT is admitted

CONTEXTUAL EXAMPLES:
&quot;The patient was admitted to the hospital.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;hospital&quot; =&gt; setting
RELATION: SOURCE =&gt; is admitted =&gt; TARGET
&quot;She was admitted to the ICU.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;ICU&quot; =&gt; setting
RELATION: SOURCE =&gt; is admitted =&gt; TARGET
&quot;He was admitted for observation.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;observation&quot; =&gt; setting
RELATION: SOURCE =&gt; is admitted =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is admitted</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000011 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000011">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <obo:IAO_0000112>Here for packing and splint removal after recent discharge from rehab</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that an intervention or finding precedes an intervention or finding.</obo:IAO_0000115>
        <obo:IAO_0000232>Used to be &quot;is followed by&quot; but this causes confusion when following refers to a particular clilnician responsible for a patient&apos;s care</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4272244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:367409002</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000011</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;preceded by&quot; =&gt; precedes
&quot;before&quot; =&gt; precedes
&quot;followed by&quot; =&gt; precedes

NEGATIVE EXAMPLES:
&quot;because of&quot; =&gt; has reason, NOT precedes
&quot;caused by&quot; =&gt; is caused by, NOT precedes
&quot;recommended&quot; =&gt; recommended, NOT precedes

CONTEXTUAL EXAMPLES:
&quot;The biopsy preceded the surgery.&quot;
SOURCE: &quot;biopsy&quot; =&gt; intervention; TARGET: &quot;surgery&quot; =&gt; intervention
RELATION: SOURCE =&gt; precedes =&gt; TARGET
&quot;The fever occurred before the rash.&quot;
SOURCE: &quot;fever&quot; =&gt; finding; TARGET: &quot;rash&quot; =&gt; finding
RELATION: SOURCE =&gt; precedes =&gt; TARGET
&quot;The follow-up visit followed hospital discharge.&quot;
SOURCE: &quot;hospital discharge&quot; =&gt; intervention; TARGET: &quot;follow-up visit&quot; =&gt; intervention
RELATION: SOURCE =&gt; precedes =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>precedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000012 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000012">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000108"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <obo:IAO_0000112>A barium swallow was performed by Dr. PHI which was concerning for moderate aspiration.  Additionally, a hard palate lesion was seen.</obo:IAO_0000112>
        <obo:IAO_0000115>Report of provider performing an intervention or assessment</obo:IAO_0000115>
        <obo:IAO_0000232>There is OMOP 4160030, but it is a more general type of performed.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000012</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;performed by Dr. Smith&quot; =&gt; is performed by
&quot;administered by the nurse&quot; =&gt; is performed by
&quot;read by the radiologist&quot; =&gt; is performed by

NEGATIVE EXAMPLES:
&quot;referred by Dr. Smith&quot; =&gt; is referred by, NOT is performed by
&quot;seen by the cardiologist&quot; =&gt; is seen by, NOT is performed by
&quot;recommended by the physician&quot; =&gt; recommended, NOT is performed by

CONTEXTUAL EXAMPLES:
&quot;The barium swallow was performed by Dr. Smith.&quot;
SOURCE: &quot;barium swallow&quot; =&gt; intervention; TARGET: &quot;Dr. Smith&quot; =&gt; clinician
RELATION: SOURCE =&gt; is performed by =&gt; TARGET
&quot;The medication was administered by the nurse.&quot;
SOURCE: &quot;medication&quot; =&gt; intervention; TARGET: &quot;nurse&quot; =&gt; clinician
RELATION: SOURCE =&gt; is performed by =&gt; TARGET
&quot;The scan was read by the radiologist.&quot;
SOURCE: &quot;scan&quot; =&gt; intervention; TARGET: &quot;radiologist&quot; =&gt; clinician
RELATION: SOURCE =&gt; is performed by =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is performed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000013 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000013">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000108"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000112>PHI is referred by Dr.  PHI  with PMH significant for IP</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that the patient has been referred by a clinician</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:44792349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:342701000000109</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000013</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;referred by her primary care physician&quot; =&gt; is referred by
&quot;sent by the emergency physician&quot; =&gt; is referred by
&quot;referred by the oncologist&quot; =&gt; is referred by

NEGATIVE EXAMPLES:
&quot;performed by Dr. Smith&quot; =&gt; is performed by, NOT is referred by
&quot;seen by the cardiologist&quot; =&gt; is seen by, NOT is referred by
&quot;recommended by the physician&quot; =&gt; recommended, NOT is referred by

CONTEXTUAL EXAMPLES:
&quot;The patient was referred by her primary care physician.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;primary care physician&quot; =&gt; clinician
RELATION: SOURCE =&gt; is referred by =&gt; TARGET
&quot;He was sent by the emergency physician.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;emergency physician&quot; =&gt; clinician
RELATION: SOURCE =&gt; is referred by =&gt; TARGET
&quot;She was referred by the oncologist.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;oncologist&quot; =&gt; clinician
RELATION: SOURCE =&gt; is referred by =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is referred by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000014 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000014">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000108"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000112>[Speaker 2]: I went to the ENT at PHI and they prescribed Allegra D, and I took those, they cleared it up, but they also affected my blood pressure</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that the patient has seen a clinician</obo:IAO_0000115>
        <obo:IAO_0000232>Mapping to seen by health care giver which I think is the intention here.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4091832</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:281033004</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000014</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;seen by cardiology&quot; =&gt; is seen by
&quot;evaluated by the surgeon&quot; =&gt; is seen by
&quot;followed by a neurologist&quot; =&gt; is seen by

NEGATIVE EXAMPLES:
&quot;referred by Dr. Smith&quot; =&gt; is referred by, NOT is seen by
&quot;performed by Dr. Smith&quot; =&gt; is performed by, NOT is seen by
&quot;recommended by the physician&quot; =&gt; recommended, NOT is seen by

CONTEXTUAL EXAMPLES:
&quot;The patient was seen by cardiology.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;cardiology&quot; =&gt; clinician
RELATION: SOURCE =&gt; is seen by =&gt; TARGET
&quot;She was evaluated by the surgeon.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;surgeon&quot; =&gt; clinician
RELATION: SOURCE =&gt; is seen by =&gt; TARGET
&quot;He is followed by a neurologist.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;neurologist&quot; =&gt; clinician
RELATION: SOURCE =&gt; is seen by =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is seen by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000015 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000015">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000058"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000115>Source of patient transference</obo:IAO_0000115>
        <obo:IAO_0000232>Actually &quot;transferred from department&quot; but it includes hospitals and other facilities and appears to be a general concept.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4144257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:266751003</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000015</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;transferred from the emergency department&quot; =&gt; is transferred from
&quot;sent from the outside hospital&quot; =&gt; is transferred from
&quot;moved from the ward&quot; =&gt; is transferred from

NEGATIVE EXAMPLES:
&quot;transferred to the ICU&quot; =&gt; is transferred to, NOT is transferred from
&quot;admitted to the hospital&quot; =&gt; is admitted, NOT is transferred from
&quot;discharged home&quot; =&gt; is discharged, NOT is transferred from

CONTEXTUAL EXAMPLES:
&quot;The patient was transferred from the emergency department.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;emergency department&quot; =&gt; setting
RELATION: SOURCE =&gt; is transferred from =&gt; TARGET
&quot;She was sent from the outside hospital.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;outside hospital&quot; =&gt; setting
RELATION: SOURCE =&gt; is transferred from =&gt; TARGET
&quot;He was moved from the ward.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;ward&quot; =&gt; setting
RELATION: SOURCE =&gt; is transferred from =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is transferred from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000017 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000017">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>SL nitroglycerin alleviated pain.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement about the effect of an intervention.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:44818727</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000017</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;relieved the pain&quot; =&gt; has effect
&quot;lowered blood pressure&quot; =&gt; has effect
&quot;caused nausea&quot; =&gt; has effect

NEGATIVE EXAMPLES:
&quot;was given for pain&quot; =&gt; has reason, NOT has effect
&quot;was recommended&quot; =&gt; recommended, NOT has effect
&quot;was performed by the surgeon&quot; =&gt; is performed by, NOT has effect

CONTEXTUAL EXAMPLES:
&quot;Nitroglycerin relieved the chest pain.&quot;
SOURCE: &quot;nitroglycerin&quot; =&gt; intervention; TARGET: &quot;chest pain&quot; =&gt; finding
RELATION: SOURCE =&gt; has effect =&gt; TARGET
&quot;The medication lowered her blood pressure.&quot;
SOURCE: &quot;medication&quot; =&gt; intervention; TARGET: &quot;blood pressure&quot; =&gt; finding
RELATION: SOURCE =&gt; has effect =&gt; TARGET
&quot;The antibiotic caused diarrhea.&quot;
SOURCE: &quot;antibiotic&quot; =&gt; intervention; TARGET: &quot;diarrhea&quot; =&gt; finding
RELATION: SOURCE =&gt; has effect =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has effect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000021 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000021">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>Chest Pain: &quot;she took a SL NTG&quot;</obo:IAO_0000112>
        <obo:IAO_0000115>Intervention is initiated or executed to treat a present or presumed finding or condition.</obo:IAO_0000115>
        <obo:IAO_0000232>SNOMED has partial mapping as qualifier.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMED:718771000000107</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000021</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;started chemotherapy&quot; =&gt; has intervention
&quot;underwent surgery&quot; =&gt; has intervention
&quot;received physical therapy&quot; =&gt; has intervention

NEGATIVE EXAMPLES:
&quot;was diagnosed with pneumonia&quot; =&gt; has finding, NOT has intervention
&quot;was referred to cardiology&quot; =&gt; is referred by, NOT has intervention
&quot;was admitted to the ICU&quot; =&gt; is admitted, NOT has intervention

CONTEXTUAL EXAMPLES:
&quot;The patient started chemotherapy for lymphoma.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;chemotherapy&quot; =&gt; intervention
RELATION: SOURCE =&gt; has intervention =&gt; TARGET
&quot;She underwent surgery for appendicitis.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;surgery&quot; =&gt; intervention
RELATION: SOURCE =&gt; has intervention =&gt; TARGET
&quot;He received physical therapy after the stroke.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;physical therapy&quot; =&gt; intervention
RELATION: SOURCE =&gt; has intervention =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000022 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000022">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000103"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>Vomiting since this morning</obo:IAO_0000112>
        <obo:IAO_0000115>The onset of a finding/condition</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4297758</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:77374008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>biolink:onset_qualifier</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000022</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;began yesterday&quot; =&gt; has onset
&quot;started two weeks ago&quot; =&gt; has onset
&quot;new-onset atrial fibrillation&quot; =&gt; has onset

NEGATIVE EXAMPLES:
&quot;lasting two weeks&quot; =&gt; has duration, NOT has onset
&quot;worsening over time&quot; =&gt; has course, NOT has onset
&quot;at the hospital&quot; =&gt; has setting, NOT has onset

CONTEXTUAL EXAMPLES:
&quot;The vomiting began this morning.&quot;
SOURCE: &quot;vomiting&quot; =&gt; finding; TARGET: &quot;this morning&quot; =&gt; time
RELATION: SOURCE =&gt; has onset =&gt; TARGET
&quot;She developed atrial fibrillation yesterday.&quot;
SOURCE: &quot;atrial fibrillation&quot; =&gt; finding; TARGET: &quot;yesterday&quot; =&gt; time
RELATION: SOURCE =&gt; has onset =&gt; TARGET
&quot;He has new-onset weakness.&quot;
SOURCE: &quot;weakness&quot; =&gt; finding; TARGET: &quot;new-onset&quot; =&gt; time
RELATION: SOURCE =&gt; has onset =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has onset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000023 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000023">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000058"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000112"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000115>Inference about the location where an event happened</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:3469026</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:18720000</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000023</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;performed in the operating room&quot; =&gt; has location
&quot;seen in clinic&quot; =&gt; has location
&quot;treated at home&quot; =&gt; has location

NEGATIVE EXAMPLES:
&quot;performed by Dr. Smith&quot; =&gt; is performed by, NOT has location
&quot;performed tomorrow&quot; =&gt; has date, NOT has location
&quot;performed because of pain&quot; =&gt; has reason, NOT has location

CONTEXTUAL EXAMPLES:
&quot;The procedure was performed in the operating room.&quot;
SOURCE: &quot;procedure&quot; =&gt; intervention; TARGET: &quot;operating room&quot; =&gt; setting
RELATION: SOURCE =&gt; has location =&gt; TARGET
&quot;The patient was seen in clinic.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;clinic&quot; =&gt; setting
RELATION: SOURCE =&gt; has location =&gt; TARGET
&quot;The wound was treated at home.&quot;
SOURCE: &quot;wound&quot; =&gt; finding; TARGET: &quot;home&quot; =&gt; setting
RELATION: SOURCE =&gt; has location =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000024 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000024">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000106"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>Describes pressure-like chest pain near L breast with radiation down R arm</obo:IAO_0000112>
        <obo:IAO_0000115>Information that describes or quantifies a finding/condition or intervention.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4306768</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:83568003</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000024</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;38.5 degrees Celsius&quot; =&gt; has value
&quot;severe&quot; =&gt; has value
&quot;positive for influenza&quot; =&gt; has value

NEGATIVE EXAMPLES:
&quot;fever&quot; =&gt; finding, NOT has value
&quot;MRI&quot; =&gt; intervention, NOT has value
&quot;three weeks&quot; =&gt; time or duration, NOT has value

CONTEXTUAL EXAMPLES:
&quot;The temperature was 38.5 degrees Celsius.&quot;
SOURCE: &quot;temperature&quot; =&gt; finding; TARGET: &quot;38.5 degrees Celsius&quot; =&gt; value
RELATION: SOURCE =&gt; has value =&gt; TARGET
&quot;The pain was severe.&quot;
SOURCE: &quot;pain&quot; =&gt; finding; TARGET: &quot;severe&quot; =&gt; value
RELATION: SOURCE =&gt; has value =&gt; TARGET
&quot;The test was positive for influenza.&quot;
SOURCE: &quot;test&quot; =&gt; intervention; TARGET: &quot;positive for influenza&quot; =&gt; value
RELATION: SOURCE =&gt; has value =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000025 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000025">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000112"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>The patient reported sore throat and his physical indicated swollen lymph nodes.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that the patient or a specific finding site has a finding or condition.</obo:IAO_0000115>
        <obo:IAO_0000232>Was can_cause_finding_or_condition, a statement of medical knowledge about the potential cause of a finding/condition. Now just has_finding.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:44818789</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000025</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;patient has pneumonia&quot; =&gt; has finding
&quot;examination revealed a murmur&quot; =&gt; has finding
&quot;the scan showed a mass&quot; =&gt; has finding

NEGATIVE EXAMPLES:
&quot;patient underwent surgery&quot; =&gt; has intervention, NOT has finding
&quot;patient is a physician&quot; =&gt; has participant qualifier, NOT has finding
&quot;patient was admitted&quot; =&gt; is admitted, NOT has finding

CONTEXTUAL EXAMPLES:
&quot;The patient has pneumonia.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;pneumonia&quot; =&gt; finding
RELATION: SOURCE =&gt; has finding =&gt; TARGET
&quot;Examination revealed a heart murmur.&quot;
SOURCE: &quot;examination&quot; =&gt; intervention; TARGET: &quot;heart murmur&quot; =&gt; finding
RELATION: SOURCE =&gt; has finding =&gt; TARGET
&quot;The CT scan showed a pulmonary mass.&quot;
SOURCE: &quot;CT scan&quot; =&gt; intervention; TARGET: &quot;pulmonary mass&quot; =&gt; finding
RELATION: SOURCE =&gt; has finding =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has finding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000027 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000027">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000104"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000107"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>A cystogram was attempted today but radiology was unable to inject dye through her catheter.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement providing the reason for abandoning an intervention or diagnostic process</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0000027</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;stopped because of hypotension&quot; =&gt; has abandonment reason
&quot;procedure canceled due to poor tolerance&quot; =&gt; has abandonment reason
&quot;test was not completed because the patient declined&quot; =&gt; has abandonment reason

NEGATIVE EXAMPLES:
&quot;procedure was completed&quot; =&gt; completed, NOT has abandonment reason
&quot;procedure was recommended&quot; =&gt; recommended, NOT has abandonment reason
&quot;procedure caused bleeding&quot; =&gt; has effect, NOT has abandonment reason

CONTEXTUAL EXAMPLES:
&quot;The cystogram was abandoned because the catheter could not be accessed.&quot;
SOURCE: &quot;cystogram&quot; =&gt; intervention; TARGET: &quot;catheter could not be accessed&quot; =&gt; reason
RELATION: SOURCE =&gt; has abandonment reason =&gt; TARGET
&quot;The infusion was stopped due to hypotension.&quot;
SOURCE: &quot;infusion&quot; =&gt; intervention; TARGET: &quot;hypotension&quot; =&gt; finding
RELATION: SOURCE =&gt; has abandonment reason =&gt; TARGET
&quot;The patient declined the procedure, so it was canceled.&quot;
SOURCE: &quot;procedure&quot; =&gt; intervention; TARGET: &quot;patient declined&quot; =&gt; reason
RELATION: SOURCE =&gt; has abandonment reason =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has abandonment reason</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000028 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000028">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>unable to assess for h/o exertional syncope, angina, dyspnea, etc which would warrant ICD placement</obo:IAO_0000112>
        <obo:IAO_0000115>Statement inferring that a finding/condition was assessed.</obo:IAO_0000115>
        <obo:IAO_0000232>It is anticipated that this relation will usually be negative (as seen in the example) and refer to the absence of an assessment for a particular condition.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4195693</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000028</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;assessed for pulmonary embolism&quot; =&gt; has assessment
&quot;evaluated for appendicitis&quot; =&gt; has assessment
&quot;screened for depression&quot; =&gt; has assessment

NEGATIVE EXAMPLES:
&quot;unable to assess for syncope&quot; =&gt; do not assert has assessment
&quot;treated for pneumonia&quot; =&gt; has intervention, NOT has assessment
&quot;history of diabetes&quot; =&gt; has finding, NOT has assessment

CONTEXTUAL EXAMPLES:
&quot;The patient was assessed for pulmonary embolism.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;pulmonary embolism&quot; =&gt; finding
RELATION: SOURCE =&gt; has assessment =&gt; TARGET
&quot;She was evaluated for appendicitis.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;appendicitis&quot; =&gt; finding
RELATION: SOURCE =&gt; has assessment =&gt; TARGET
&quot;The patient was screened for depression.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;depression&quot; =&gt; finding
RELATION: SOURCE =&gt; has assessment =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000030 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000030">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000104"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <obo:IAO_0000112>stop Bactrim which may worsen hyperK</obo:IAO_0000112>
        <obo:IAO_0000115>Any clinical justification or reason for ordering any intervention, including planning. If the reason is suspected, it would be qualified as uncertain.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4165917</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:416083004</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000030</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;ordered because of hyperkalemia&quot; =&gt; has reason
&quot;started for treatment of pneumonia&quot; =&gt; has reason
&quot;discontinued due to adverse effects&quot; =&gt; has reason

NEGATIVE EXAMPLES:
&quot;was caused by pneumonia&quot; =&gt; is caused by, NOT has reason
&quot;was recommended&quot; =&gt; recommended, NOT has reason
&quot;was suspected&quot; =&gt; uncertainty, NOT has reason

CONTEXTUAL EXAMPLES:
&quot;Bactrim was stopped because it worsened hyperkalemia.&quot;
SOURCE: &quot;Bactrim&quot; =&gt; intervention; TARGET: &quot;worsened hyperkalemia&quot; =&gt; reason
RELATION: SOURCE =&gt; has reason =&gt; TARGET
&quot;The MRI was ordered because of persistent headaches.&quot;
SOURCE: &quot;MRI&quot; =&gt; intervention; TARGET: &quot;persistent headaches&quot; =&gt; finding
RELATION: SOURCE =&gt; has reason =&gt; TARGET
&quot;Physical therapy was started to improve mobility.&quot;
SOURCE: &quot;physical therapy&quot; =&gt; intervention; TARGET: &quot;improve mobility&quot; =&gt; reason
RELATION: SOURCE =&gt; has reason =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has reason</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000031 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000031">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000113"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000115>Statement related to patient physiologic state</obo:IAO_0000115>
        <obo:IAO_0000232>Was represented earlier as &quot;finding related physiological patient state&quot;</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4028872</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:128973006</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000031</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;patient is stable&quot; =&gt; has state
&quot;patient is improving&quot; =&gt; has state
&quot;patient is alert and oriented&quot; =&gt; has state

NEGATIVE EXAMPLES:
&quot;stable disease&quot; =&gt; has course, NOT has state
&quot;chest pain&quot; =&gt; has finding, NOT has state
&quot;physician&quot; =&gt; clinician, NOT has state

CONTEXTUAL EXAMPLES:
&quot;The patient is clinically stable.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;clinically stable&quot; =&gt; patient state
RELATION: SOURCE =&gt; has state =&gt; TARGET
&quot;The patient is improving after treatment.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;improving&quot; =&gt; patient state
RELATION: SOURCE =&gt; has state =&gt; TARGET
&quot;The patient is alert and oriented.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;alert and oriented&quot; =&gt; patient state
RELATION: SOURCE =&gt; has state =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000034 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000034">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000104"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000109"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>Please call if we can be of further assistance or his echo is abnormal</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that an intervention or task will be triggered by an event</obo:IAO_0000115>
        <obo:IAO_0000232>Referred by trigger criteria may be best fit.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:44787854</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:109721000000108</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000034</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;if fever develops, call the clinic&quot; =&gt; has trigger
&quot;abnormal results prompted admission&quot; =&gt; has trigger
&quot;worsening symptoms led to escalation&quot; =&gt; has trigger

NEGATIVE EXAMPLES:
&quot;admission was caused by pneumonia&quot; =&gt; is caused by, NOT has trigger
&quot;admission was recommended&quot; =&gt; recommended, NOT has trigger
&quot;admission is suspected&quot; =&gt; uncertainty, NOT has trigger

CONTEXTUAL EXAMPLES:
&quot;If the fever returns, call the clinic.&quot;
SOURCE: &quot;fever returns&quot; =&gt; finding; TARGET: &quot;call the clinic&quot; =&gt; task
RELATION: SOURCE =&gt; has trigger =&gt; TARGET
&quot;The abnormal CT result prompted admission.&quot;
SOURCE: &quot;abnormal CT result&quot; =&gt; finding; TARGET: &quot;admission&quot; =&gt; intervention
RELATION: SOURCE =&gt; has trigger =&gt; TARGET
&quot;Worsening hypoxia led to escalation of respiratory support.&quot;
SOURCE: &quot;worsening hypoxia&quot; =&gt; finding; TARGET: &quot;escalation of respiratory support&quot; =&gt; intervention
RELATION: SOURCE =&gt; has trigger =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has trigger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000035 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000035">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000112>PHI presents today for follow-up evaluation regarding management of lower urinary tract symptoms.</obo:IAO_0000112>
        <obo:IAO_0000115>Rationale for an outpatient visit</obo:IAO_0000115>
        <obo:IAO_0000232>Was previously &quot;has visit reason&quot; but the object was finding or intervention, not reason. Name was therefore changed to rationale to avoid confusion.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>LOINC:29298-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:3025141</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000035</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;visit for follow-up of lower urinary tract symptoms&quot; =&gt; has visit rationale
&quot;seen for evaluation of chest pain&quot; =&gt; has visit rationale
&quot;return visit for medication management&quot; =&gt; has visit rationale

NEGATIVE EXAMPLES:
&quot;was referred by Dr. Smith&quot; =&gt; is referred by, NOT has visit rationale
&quot;was admitted to the ICU&quot; =&gt; is admitted, NOT has visit rationale
&quot;was treated with antibiotics&quot; =&gt; has intervention, NOT has visit rationale

CONTEXTUAL EXAMPLES:
&quot;The patient presented for follow-up of lower urinary tract symptoms.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;lower urinary tract symptoms&quot; =&gt; finding
RELATION: SOURCE =&gt; has visit rationale =&gt; TARGET
&quot;She was seen for evaluation of chest pain.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;chest pain&quot; =&gt; finding
RELATION: SOURCE =&gt; has visit rationale =&gt; TARGET
&quot;He returned for medication management.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;medication management&quot; =&gt; intervention
RELATION: SOURCE =&gt; has visit rationale =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has visit rationale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000036 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000036">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>She had a MVC that resulted in extraperitoneal bladder injury and pelvic and sacral fractures.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement about the cause of a finding/condition</obo:IAO_0000115>
        <obo:IAO_0000232>There is condition cause which is non-standard LOINC</obo:IAO_0000232>
        <oboInOwl:hasDbXref>LOINC:LP430632-2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:1992175</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000036</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;fracture caused by a fall&quot; =&gt; is caused by
&quot;dyspnea due to pneumonia&quot; =&gt; is caused by
&quot;bleeding secondary to anticoagulation&quot; =&gt; is caused by

NEGATIVE EXAMPLES:
&quot;MRI ordered because of headache&quot; =&gt; has reason, NOT is caused by
&quot;possible pneumonia&quot; =&gt; uncertainty, NOT is caused by
&quot;fever preceded the rash&quot; =&gt; precedes, NOT is caused by

CONTEXTUAL EXAMPLES:
&quot;The fracture was caused by a fall.&quot;
SOURCE: &quot;fracture&quot; =&gt; finding; TARGET: &quot;fall&quot; =&gt; finding
RELATION: SOURCE =&gt; is caused by =&gt; TARGET
&quot;The dyspnea was due to pneumonia.&quot;
SOURCE: &quot;dyspnea&quot; =&gt; finding; TARGET: &quot;pneumonia&quot; =&gt; finding
RELATION: SOURCE =&gt; is caused by =&gt; TARGET
&quot;Bleeding was secondary to anticoagulation.&quot;
SOURCE: &quot;bleeding&quot; =&gt; finding; TARGET: &quot;anticoagulation&quot; =&gt; intervention
RELATION: SOURCE =&gt; is caused by =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is caused by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000037 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000037">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>She reports her catheter has been leaking today especially when trying to have a bowel movement.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that procedure, intervention or finding/condition is complicated by an event</obo:IAO_0000115>
        <obo:IAO_0000232>Using complications, but not a relationship, may need new term.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4137797</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:263718001</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000037</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;wound complicated by infection&quot; =&gt; is complicated by
&quot;surgery complicated by bleeding&quot; =&gt; is complicated by
&quot;fracture complicated by nonunion&quot; =&gt; is complicated by

NEGATIVE EXAMPLES:
&quot;infection caused the wound&quot; =&gt; is caused by, NOT is complicated by
&quot;surgery was followed by bleeding&quot; =&gt; precedes, NOT is complicated by
&quot;bleeding was suspected&quot; =&gt; uncertainty, NOT is complicated by

CONTEXTUAL EXAMPLES:
&quot;The wound was complicated by infection.&quot;
SOURCE: &quot;wound&quot; =&gt; finding; TARGET: &quot;infection&quot; =&gt; finding
RELATION: SOURCE =&gt; is complicated by =&gt; TARGET
&quot;The surgery was complicated by bleeding.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention; TARGET: &quot;bleeding&quot; =&gt; finding
RELATION: SOURCE =&gt; is complicated by =&gt; TARGET
&quot;The fracture was complicated by nonunion.&quot;
SOURCE: &quot;fracture&quot; =&gt; finding; TARGET: &quot;nonunion&quot; =&gt; finding
RELATION: SOURCE =&gt; is complicated by =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is complicated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000038 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000038">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000115>A diagnostic process outcome is consistent with a condition. Whether this process is required or sufficient is not addressed.</obo:IAO_0000115>
        <obo:IAO_0000232>Was &quot;Statement indicating that a diagnostic process does not suggest a finding/condition&quot;.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000038</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;imaging consistent with pneumonia&quot; =&gt; is consistent with diagnosis
&quot;biopsy consistent with malignancy&quot; =&gt; is consistent with diagnosis
&quot;findings consistent with appendicitis&quot; =&gt; is consistent with diagnosis

NEGATIVE EXAMPLES:
&quot;imaging ruled out pneumonia&quot; =&gt; negation, NOT is consistent with diagnosis
&quot;biopsy suggested possible malignancy&quot; =&gt; uncertainty, NOT is consistent with diagnosis
&quot;MRI was ordered for headache&quot; =&gt; has reason, NOT is consistent with diagnosis

CONTEXTUAL EXAMPLES:
&quot;The CT findings were consistent with pneumonia.&quot;
SOURCE: &quot;CT findings&quot; =&gt; finding; TARGET: &quot;pneumonia&quot; =&gt; finding
RELATION: SOURCE =&gt; is consistent with diagnosis =&gt; TARGET
&quot;The biopsy was consistent with malignancy.&quot;
SOURCE: &quot;biopsy&quot; =&gt; intervention; TARGET: &quot;malignancy&quot; =&gt; finding
RELATION: SOURCE =&gt; is consistent with diagnosis =&gt; TARGET
&quot;The clinical findings were consistent with appendicitis.&quot;
SOURCE: &quot;clinical findings&quot; =&gt; finding; TARGET: &quot;appendicitis&quot; =&gt; finding
RELATION: SOURCE =&gt; is consistent with diagnosis =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is consistent with diagnosis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000040 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000040">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <obo:IAO_0000115>A clinical reason related to a treatment such as procedure, medication, or lifestyle recommendation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT:363675004</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000040</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;antibiotics for pneumonia&quot; =&gt; treatment reason
&quot;physical therapy to improve mobility&quot; =&gt; treatment reason
&quot;smoking cessation to reduce cardiovascular risk&quot; =&gt; treatment reason

NEGATIVE EXAMPLES:
&quot;antibiotics caused diarrhea&quot; =&gt; has effect, NOT treatment reason
&quot;antibiotics were recommended&quot; =&gt; recommended, NOT treatment reason
&quot;antibiotics were suspected&quot; =&gt; uncertainty, NOT treatment reason

CONTEXTUAL EXAMPLES:
&quot;Antibiotics were prescribed for pneumonia.&quot;
SOURCE: &quot;antibiotics&quot; =&gt; intervention; TARGET: &quot;pneumonia&quot; =&gt; finding
RELATION: SOURCE =&gt; treatment reason =&gt; TARGET
&quot;Physical therapy was ordered to improve mobility.&quot;
SOURCE: &quot;physical therapy&quot; =&gt; intervention; TARGET: &quot;improve mobility&quot; =&gt; reason
RELATION: SOURCE =&gt; treatment reason =&gt; TARGET
&quot;Smoking cessation was advised to reduce cardiovascular risk.&quot;
SOURCE: &quot;smoking cessation&quot; =&gt; intervention; TARGET: &quot;reduce cardiovascular risk&quot; =&gt; reason
RELATION: SOURCE =&gt; treatment reason =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>treatment reason</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000041 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000041">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000005"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000104"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000105"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000107"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000111"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000108"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>I saw and evaluated the patient. I reviewed the findings and assessment/plan outlined above by PHI and agree</obo:IAO_0000112>
        <obo:IAO_0000115>Statement denoting a clinician&apos;s or patient&apos;s agreement with another clinician&apos;s assessment, recommendation or reasoning.</obo:IAO_0000115>
        <obo:IAO_0000232>Mapping to &quot;does agree with care plan&quot;.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:37018830</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:714831004</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000041</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;agreed to proceed with surgery&quot; =&gt; agree with
&quot;concurred with the treatment plan&quot; =&gt; agree with
&quot;accepted the recommendation&quot; =&gt; agree with

NEGATIVE EXAMPLES:
&quot;declined surgery&quot; =&gt; negation or has decision, NOT agree with
&quot;recommended surgery&quot; =&gt; recommended, NOT agree with
&quot;suspected pneumonia&quot; =&gt; uncertainty, NOT agree with

CONTEXTUAL EXAMPLES:
&quot;The patient agreed to proceed with surgery.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;surgery&quot; =&gt; intervention
RELATION: SOURCE =&gt; agree with =&gt; TARGET
&quot;The family concurred with the treatment plan.&quot;
SOURCE: &quot;family&quot; =&gt; family member; TARGET: &quot;treatment plan&quot; =&gt; intervention
RELATION: SOURCE =&gt; agree with =&gt; TARGET
&quot;The patient accepted the recommendation.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;recommendation&quot; =&gt; clinical decision
RELATION: SOURCE =&gt; agree with =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>agree with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000042 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000042">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000005"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>Ultimately her goal is to not have to live with bilateral nephrostomy tubes.</obo:IAO_0000112>
        <obo:IAO_0000115>Indication that an intervention or the patient has an outcome goal (target)</obo:IAO_0000115>
        <obo:IAO_0000232>OMOP 4253630 &quot;Goal&quot;  doesn&apos;t really match well, we may need a new term.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4253630</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000042</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;goal of pain control&quot; =&gt; has goal
&quot;target blood pressure below 130/80&quot; =&gt; has goal
&quot;aim of preventing recurrence&quot; =&gt; has goal

NEGATIVE EXAMPLES:
&quot;reason for surgery&quot; =&gt; has reason, NOT has goal
&quot;recommended surgery&quot; =&gt; recommended, NOT has goal
&quot;completed treatment&quot; =&gt; completed, NOT has goal

CONTEXTUAL EXAMPLES:
&quot;The goal is pain control.&quot;
SOURCE: &quot;intervention&quot; =&gt; intervention; TARGET: &quot;pain control&quot; =&gt; finding
RELATION: SOURCE =&gt; has goal =&gt; TARGET
&quot;The target blood pressure is below 130/80.&quot;
SOURCE: &quot;blood pressure management&quot; =&gt; intervention; TARGET: &quot;below 130/80&quot; =&gt; value
RELATION: SOURCE =&gt; has goal =&gt; TARGET
&quot;The aim is to prevent recurrence.&quot;
SOURCE: &quot;treatment&quot; =&gt; intervention; TARGET: &quot;prevent recurrence&quot; =&gt; finding
RELATION: SOURCE =&gt; has goal =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000043 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000043">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000005"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000108"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>Will discuss with interventional in AM about possible pulmonary vein dilation w/stenting</obo:IAO_0000112>
        <obo:IAO_0000115>A statement indicating that a clinician or patient has a decision concerning an intervention.</obo:IAO_0000115>
        <obo:IAO_0000232>May needs new label, was previously has_pending_decision, but with modifieres this can be scoped more specifically.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000043</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;decided to order an MRI&quot; =&gt; has decision
&quot;decision to start chemotherapy&quot; =&gt; has decision
&quot;will discuss surgical repair&quot; =&gt; has decision

NEGATIVE EXAMPLES:
&quot;MRI was performed&quot; =&gt; is performed by or completed, NOT has decision
&quot;MRI was recommended&quot; =&gt; recommended, NOT has decision
&quot;MRI was suspected&quot; =&gt; uncertainty, NOT has decision

CONTEXTUAL EXAMPLES:
&quot;The clinician decided to order an MRI.&quot;
SOURCE: &quot;clinician&quot; =&gt; clinician; TARGET: &quot;order an MRI&quot; =&gt; intervention
RELATION: SOURCE =&gt; has decision =&gt; TARGET
&quot;The team decided to start chemotherapy.&quot;
SOURCE: &quot;team&quot; =&gt; clinician; TARGET: &quot;start chemotherapy&quot; =&gt; intervention
RELATION: SOURCE =&gt; has decision =&gt; TARGET
&quot;The patient will discuss surgical repair.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;surgical repair&quot; =&gt; intervention
RELATION: SOURCE =&gt; has decision =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has decision</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000044 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000044">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000005"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000105"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000106"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000115>Statement indicating that a finding/condition is at goal</obo:IAO_0000115>
        <obo:IAO_0000232>Goal achieved in SNOMED, rename if acceptable.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4191706</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:390802008</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000044</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;at goal&quot; =&gt; is at goal
&quot;met the target&quot; =&gt; is at goal
&quot;reached the desired blood pressure&quot; =&gt; is at goal

NEGATIVE EXAMPLES:
&quot;goal of pain control&quot; =&gt; has goal, NOT is at goal
&quot;worsening symptoms&quot; =&gt; has course, NOT is at goal
&quot;recommended target&quot; =&gt; recommended, NOT is at goal

CONTEXTUAL EXAMPLES:
&quot;The patient&apos;s blood pressure is at goal.&quot;
SOURCE: &quot;blood pressure&quot; =&gt; finding; TARGET: &quot;at goal&quot; =&gt; patient state
RELATION: SOURCE =&gt; is at goal =&gt; TARGET
&quot;The treatment met the target.&quot;
SOURCE: &quot;treatment&quot; =&gt; intervention; TARGET: &quot;target&quot; =&gt; value
RELATION: SOURCE =&gt; is at goal =&gt; TARGET
&quot;The patient reached the desired glucose level.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;desired glucose level&quot; =&gt; value
RELATION: SOURCE =&gt; is at goal =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is at goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000045 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000045">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000049"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000111"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000115>Statement about documentation of a finding/condition</obo:IAO_0000115>
        <obo:IAO_0000232>Maps to SNOMED qualifier Reference documentation which is probably equivalent.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4205679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:308910008</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000045</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;the record documents hypertension&quot; =&gt; documentation of finding
&quot;the imaging report describes a mass&quot; =&gt; documentation of finding
&quot;the discharge summary notes anemia&quot; =&gt; documentation of finding

NEGATIVE EXAMPLES:
&quot;the patient has hypertension&quot; =&gt; has finding, NOT documentation of finding
&quot;the patient underwent surgery&quot; =&gt; has intervention, NOT documentation of finding
&quot;the physician recommended treatment&quot; =&gt; recommended, NOT documentation of finding

CONTEXTUAL EXAMPLES:
&quot;The medical record documents hypertension.&quot;
SOURCE: &quot;medical record&quot; =&gt; documentation; TARGET: &quot;hypertension&quot; =&gt; finding
RELATION: SOURCE =&gt; documentation of finding =&gt; TARGET
&quot;The imaging report describes a pulmonary mass.&quot;
SOURCE: &quot;imaging report&quot; =&gt; documentation; TARGET: &quot;pulmonary mass&quot; =&gt; finding
RELATION: SOURCE =&gt; documentation of finding =&gt; TARGET
&quot;The discharge summary notes anemia.&quot;
SOURCE: &quot;discharge summary&quot; =&gt; documentation; TARGET: &quot;anemia&quot; =&gt; finding
RELATION: SOURCE =&gt; documentation of finding =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>documentation of finding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000046 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000046">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000040"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000115>Statement indicating that the patient is a candidate for a given intervention, commonly used in the negative.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0000046</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;eligible for surgery&quot; =&gt; is eligible
&quot;eligible for transplant evaluation&quot; =&gt; is eligible
&quot;meets criteria for chemotherapy&quot; =&gt; is eligible

NEGATIVE EXAMPLES:
&quot;contraindicated for surgery&quot; =&gt; has contraindication, NOT is eligible
&quot;referred for surgery&quot; =&gt; is referred by, NOT is eligible
&quot;scheduled for surgery&quot; =&gt; has intention, NOT is eligible

CONTEXTUAL EXAMPLES:
&quot;The patient is eligible for surgery.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;surgery&quot; =&gt; intervention
RELATION: SOURCE =&gt; is eligible =&gt; TARGET
&quot;She meets criteria for transplant evaluation.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;transplant evaluation&quot; =&gt; intervention
RELATION: SOURCE =&gt; is eligible =&gt; TARGET
&quot;He is eligible for chemotherapy.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;chemotherapy&quot; =&gt; intervention
RELATION: SOURCE =&gt; is eligible =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is eligible</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000048 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000048">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000049"/>
        <rdfs:range>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000108"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:range>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000115>Statement indicating that an intervention has been discussed with patient by a clinician (clinician initiated) or a patient has discussed an intervention with their clinician (patient initiated). The default assumption should be that the discussion is clinician initiated.</obo:IAO_0000115>
        <obo:IAO_0000232>Likely need to break this down for reasoning, values available include separate concepts for discussion with caregiver, patient, specialist, pharmacist, payer, etc...</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000048</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;discussed surgery with the patient&quot; =&gt; discussed with
&quot;reviewed chemotherapy with the family&quot; =&gt; discussed with
&quot;discussed the MRI with cardiology&quot; =&gt; discussed with

NEGATIVE EXAMPLES:
&quot;recommended surgery&quot; =&gt; recommended, NOT discussed with
&quot;performed surgery&quot; =&gt; completed, NOT discussed with
&quot;referred to cardiology&quot; =&gt; is referred by, NOT discussed with

CONTEXTUAL EXAMPLES:
&quot;The surgeon discussed surgery with the patient.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention; TARGET: &quot;patient&quot; =&gt; patient
RELATION: SOURCE =&gt; discussed with =&gt; TARGET
&quot;Chemotherapy was reviewed with the family.&quot;
SOURCE: &quot;chemotherapy&quot; =&gt; intervention; TARGET: &quot;family&quot; =&gt; family member
RELATION: SOURCE =&gt; discussed with =&gt; TARGET
&quot;The MRI was discussed with cardiology.&quot;
SOURCE: &quot;MRI&quot; =&gt; intervention; TARGET: &quot;cardiology&quot; =&gt; clinician
RELATION: SOURCE =&gt; discussed with =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>discussed with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000049 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000049">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000003"/>
        <obo:IAO_0000115>A decision or status has been confirmed.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4326761</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:74996004</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000049</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;confirmed diagnosis&quot; =&gt; has confirmation
&quot;confirmed treatment plan&quot; =&gt; has confirmation
&quot;confirmed appointment&quot; =&gt; has confirmation

NEGATIVE EXAMPLES:
&quot;suspected diagnosis&quot; =&gt; uncertainty, NOT has confirmation
&quot;recommended treatment&quot; =&gt; recommended, NOT has confirmation
&quot;denied symptoms&quot; =&gt; negation, NOT has confirmation

CONTEXTUAL EXAMPLES:
&quot;The diagnosis was confirmed.&quot;
SOURCE: &quot;diagnosis&quot; =&gt; finding; TARGET: &quot;confirmed&quot; =&gt; confirmation
RELATION: SOURCE =&gt; has confirmation =&gt; TARGET
&quot;The treatment plan was confirmed.&quot;
SOURCE: &quot;treatment plan&quot; =&gt; intervention; TARGET: &quot;confirmed&quot; =&gt; confirmation
RELATION: SOURCE =&gt; has confirmation =&gt; TARGET
&quot;The appointment was confirmed.&quot;
SOURCE: &quot;appointment&quot; =&gt; task; TARGET: &quot;confirmed&quot; =&gt; confirmation
RELATION: SOURCE =&gt; has confirmation =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has confirmation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000050 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000050">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000040"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000102"/>
        <obo:IAO_0000112>warfarin has contraindication pregnancy.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement about the contraindication of an intervention. The intervention should not be used for the condition because it may cause harm to the patient or outweigh potential benefits.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4011945</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:103306004</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000050</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;warfarin contraindicated in pregnancy&quot; =&gt; has contraindication
&quot;NSAIDs contraindicated in renal failure&quot; =&gt; has contraindication
&quot;chemotherapy contraindicated by severe neutropenia&quot; =&gt; has contraindication

NEGATIVE EXAMPLES:
&quot;warfarin prescribed for atrial fibrillation&quot; =&gt; has reason, NOT has contraindication
&quot;chemotherapy was recommended&quot; =&gt; recommended, NOT has contraindication
&quot;chemotherapy was suspected&quot; =&gt; uncertainty, NOT has contraindication

CONTEXTUAL EXAMPLES:
&quot;Warfarin is contraindicated in pregnancy.&quot;
SOURCE: &quot;warfarin&quot; =&gt; intervention; TARGET: &quot;pregnancy&quot; =&gt; finding
RELATION: SOURCE =&gt; has contraindication =&gt; TARGET
&quot;NSAIDs are contraindicated in severe renal failure.&quot;
SOURCE: &quot;NSAIDs&quot; =&gt; intervention; TARGET: &quot;severe renal failure&quot; =&gt; finding
RELATION: SOURCE =&gt; has contraindication =&gt; TARGET
&quot;Chemotherapy is contraindicated because of severe neutropenia.&quot;
SOURCE: &quot;chemotherapy&quot; =&gt; intervention; TARGET: &quot;severe neutropenia&quot; =&gt; finding
RELATION: SOURCE =&gt; has contraindication =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has contraindication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000051 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000051">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000105"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>Her shortness of breath is becoming worse</obo:IAO_0000112>
        <obo:IAO_0000115>The course of a finding/condition</obo:IAO_0000115>
        <obo:IAO_0000232>The same thing as clinical course.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4137632</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:263502005</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000051</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;worsening&quot; =&gt; has course
&quot;stable&quot; =&gt; has course
&quot;intermittent&quot; =&gt; has course

NEGATIVE EXAMPLES:
&quot;three weeks&quot; =&gt; has duration, NOT has course
&quot;yesterday&quot; =&gt; has date, NOT has course
&quot;severe&quot; =&gt; has severity, NOT has course

CONTEXTUAL EXAMPLES:
&quot;The patient reports worsening weakness.&quot;
SOURCE: &quot;weakness&quot; =&gt; finding; TARGET: &quot;worsening&quot; =&gt; course
RELATION: SOURCE =&gt; has course =&gt; TARGET
&quot;Her symptoms remain stable.&quot;
SOURCE: &quot;symptoms&quot; =&gt; finding; TARGET: &quot;stable&quot; =&gt; course
RELATION: SOURCE =&gt; has course =&gt; TARGET
&quot;He has intermittent chest pain.&quot;
SOURCE: &quot;chest pain&quot; =&gt; finding; TARGET: &quot;intermittent&quot; =&gt; course
RELATION: SOURCE =&gt; has course =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has course</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000052 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000052">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000103"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>She has an appointment with Dr. PHI tomorrow</obo:IAO_0000112>
        <obo:IAO_0000115>Inference about the time when an event has happened or will happen</obo:IAO_0000115>
        <obo:IAO_0000232>SNOMED attribute, qualifier is also available. Start and End dates?</obo:IAO_0000232>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4256607</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:410671006</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000052</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;tomorrow&quot; =&gt; has date
&quot;on March 3&quot; =&gt; has date
&quot;last Tuesday&quot; =&gt; has date

NEGATIVE EXAMPLES:
&quot;for three weeks&quot; =&gt; has duration, NOT has date
&quot;currently&quot; =&gt; has temporal frame, NOT has date
&quot;worsening&quot; =&gt; has course, NOT has date

CONTEXTUAL EXAMPLES:
&quot;The patient has an appointment tomorrow.&quot;
SOURCE: &quot;appointment&quot; =&gt; intervention; TARGET: &quot;tomorrow&quot; =&gt; time
RELATION: SOURCE =&gt; has date =&gt; TARGET
&quot;Surgery is scheduled for March 3.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention; TARGET: &quot;March 3&quot; =&gt; time
RELATION: SOURCE =&gt; has date =&gt; TARGET
&quot;The symptoms began last Tuesday.&quot;
SOURCE: &quot;symptoms&quot; =&gt; finding; TARGET: &quot;last Tuesday&quot; =&gt; time
RELATION: SOURCE =&gt; has date =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has date</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000053 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000053">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000103"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>She does endorse some nausea and spit up for the past two weeks</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating the duration of a finding/condition or intervention</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4014044</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000053</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;for two weeks&quot; =&gt; has duration
&quot;lasting three months&quot; =&gt; has duration
&quot;over the past year&quot; =&gt; has duration

NEGATIVE EXAMPLES:
&quot;yesterday&quot; =&gt; has date, NOT has duration
&quot;worsening&quot; =&gt; has course, NOT has duration
&quot;severe&quot; =&gt; has severity, NOT has duration

CONTEXTUAL EXAMPLES:
&quot;She has had nausea for two weeks.&quot;
SOURCE: &quot;nausea&quot; =&gt; finding; TARGET: &quot;for two weeks&quot; =&gt; time
RELATION: SOURCE =&gt; has duration =&gt; TARGET
&quot;The cough has lasted three months.&quot;
SOURCE: &quot;cough&quot; =&gt; finding; TARGET: &quot;three months&quot; =&gt; time
RELATION: SOURCE =&gt; has duration =&gt; TARGET
&quot;Pain has persisted over the past year.&quot;
SOURCE: &quot;pain&quot; =&gt; finding; TARGET: &quot;over the past year&quot; =&gt; time
RELATION: SOURCE =&gt; has duration =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000054">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002501"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002502"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000058 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000058">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000107"/>
        <obo:IAO_0000112>He was given Zofran and meclizine at Urgent Care.</obo:IAO_0000112>
        <obo:IAO_0000115>Inference about the location or setting where a clinical event happened.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:32462</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000058</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;in the emergency department&quot; =&gt; has setting
&quot;at home&quot; =&gt; has setting
&quot;in the intensive care unit&quot; =&gt; has setting

NEGATIVE EXAMPLES:
&quot;chest pain&quot; =&gt; finding, NOT has setting
&quot;tomorrow&quot; =&gt; has date, NOT has setting
&quot;physician&quot; =&gt; clinician, NOT has setting

CONTEXTUAL EXAMPLES:
&quot;The patient was treated in the emergency department.&quot;
SOURCE: &quot;treated&quot; =&gt; intervention; TARGET: &quot;emergency department&quot; =&gt; setting
RELATION: SOURCE =&gt; has setting =&gt; TARGET
&quot;The wound was managed at home.&quot;
SOURCE: &quot;wound management&quot; =&gt; intervention; TARGET: &quot;at home&quot; =&gt; setting
RELATION: SOURCE =&gt; has setting =&gt; TARGET
&quot;He was monitored in the intensive care unit.&quot;
SOURCE: &quot;monitored&quot; =&gt; task; TARGET: &quot;intensive care unit&quot; =&gt; setting
RELATION: SOURCE =&gt; has setting =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has setting</rdfs:label>
    </owl:ObjectProperty>
    


    


    


    


    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000068 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000068">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000067"/>
        <obo:IAO_0000115>An association qualifier that modifies the entire clinical statement, such as intention, recommendation or completion status.</obo:IAO_0000115>
        <obo:IAO_0000232>Qualifiers for the entire statement.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000068</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;intended&quot; =&gt; statement qualifier
&quot;recommended&quot; =&gt; statement qualifier
&quot;pending&quot; =&gt; statement qualifier
&quot;completed&quot; =&gt; statement qualifier

NEGATIVE EXAMPLES:
&quot;suspected&quot; =&gt; uncertainty, NOT statement qualifier
&quot;denied&quot; =&gt; negation, NOT statement qualifier
&quot;left&quot; =&gt; participant qualifier, NOT statement qualifier
&quot;last year&quot; =&gt; temporal frame, NOT statement qualifier

CONTEXTUAL EXAMPLES:
&quot;The patient intended to undergo surgery.&quot;
SOURCE: &quot;surgery&quot; =&gt; intervention; TARGET: &quot;intended&quot; =&gt; statement qualifier
RELATION: SOURCE =&gt; has statement qualifier =&gt; TARGET
&quot;The physician recommended an MRI.&quot;
SOURCE: &quot;MRI&quot; =&gt; intervention; TARGET: &quot;recommended&quot; =&gt; statement qualifier
RELATION: SOURCE =&gt; has statement qualifier =&gt; TARGET
&quot;The biopsy was completed.&quot;
SOURCE: &quot;biopsy&quot; =&gt; intervention; TARGET: &quot;completed&quot; =&gt; statement qualifier
RELATION: SOURCE =&gt; has statement qualifier =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>statement qualifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000069 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000069">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000067"/>
        <obo:IAO_0000115>An association qualifier that modifies only the predicate (relationship type) of a clinical association, rather than the entire statement.</obo:IAO_0000115>
        <obo:IAO_0000232>For situations where the modifier of the predicate is different from the overall statement, these are likely to be rare.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000069</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;has finding: suspected&quot; =&gt; predicate qualifier
&quot;has intervention: recommended&quot; =&gt; predicate qualifier
&quot;has finding: negated&quot; =&gt; predicate qualifier
&quot;has finding: historical&quot; =&gt; predicate qualifier

NEGATIVE EXAMPLES:
&quot;suspected tumor&quot; =&gt; uncertainty, NOT predicate qualifier
&quot;denied fever&quot; =&gt; negation, NOT predicate qualifier
&quot;completed biopsy&quot; =&gt; completion status, NOT predicate qualifier
&quot;patient&apos;s mother&quot; =&gt; participant qualifier, NOT predicate qualifier

CONTEXTUAL EXAMPLES:
&quot;The scan suggested a tumor.&quot;
SOURCE: &quot;has finding&quot; =&gt; predicate; TARGET: &quot;suggested&quot; =&gt; predicate qualifier
RELATION: SOURCE =&gt; has predicate qualifier =&gt; TARGET
&quot;The record documented a historical diagnosis.&quot;
SOURCE: &quot;has diagnosis&quot; =&gt; predicate; TARGET: &quot;historical&quot; =&gt; predicate qualifier
RELATION: SOURCE =&gt; has predicate qualifier =&gt; TARGET
&quot;The note described a negated finding.&quot;
SOURCE: &quot;has finding&quot; =&gt; predicate; TARGET: &quot;negated&quot; =&gt; predicate qualifier
RELATION: SOURCE =&gt; has predicate qualifier =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>predicate qualifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000071 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000071">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000106"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>Bone density is decreasing; cancer progression is rapid.</obo:IAO_0000112>
        <obo:IAO_0000115>A finding association specifying which facet, part, or functional dimension of an entity is being referred to in the assertion.</obo:IAO_0000115>
        <obo:IAO_0000232>Aspect refers to which facet, part, or functional dimension of an entity is being referred to in the assertion. For example density or progression in bone density or cancer progression.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000071</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;bone density&quot; =&gt; has aspect
&quot;cancer progression&quot; =&gt; has aspect
&quot;cardiac function&quot; =&gt; has aspect

NEGATIVE EXAMPLES:
&quot;left knee&quot; =&gt; has spatial orientation or has laterality, NOT has aspect
&quot;severe pain&quot; =&gt; has severity, NOT has aspect
&quot;three weeks&quot; =&gt; has duration, NOT has aspect

CONTEXTUAL EXAMPLES:
&quot;Bone density is decreasing.&quot;
SOURCE: &quot;bone&quot; =&gt; finding site; TARGET: &quot;density&quot; =&gt; value
RELATION: SOURCE =&gt; has aspect =&gt; TARGET
&quot;Cancer progression is rapid.&quot;
SOURCE: &quot;cancer&quot; =&gt; finding; TARGET: &quot;progression&quot; =&gt; course
RELATION: SOURCE =&gt; has aspect =&gt; TARGET
&quot;Cardiac function is preserved.&quot;
SOURCE: &quot;cardiac&quot; =&gt; finding site; TARGET: &quot;function&quot; =&gt; value
RELATION: SOURCE =&gt; has aspect =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has aspect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000072 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000072">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000112"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>The lesion is located on the anterior aspect of the left knee.</obo:IAO_0000112>
        <obo:IAO_0000115>A finding association specifying the spatial orientation or anatomical direction of a finding relative to a body site.</obo:IAO_0000115>
        <obo:IAO_0000232>Spatial orientation qualifiers reuse PATO quality terms directly; CLCO defines only the attachment role.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000072</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;anterior to the knee&quot; =&gt; has spatial orientation
&quot;below the diaphragm&quot; =&gt; has spatial orientation
&quot;posterior to the heart&quot; =&gt; has spatial orientation

NEGATIVE EXAMPLES:
&quot;left knee&quot; =&gt; has laterality, NOT has spatial orientation
&quot;severe pain&quot; =&gt; has severity, NOT has spatial orientation
&quot;three weeks&quot; =&gt; has duration, NOT has spatial orientation

CONTEXTUAL EXAMPLES:
&quot;The lesion is anterior to the knee.&quot;
SOURCE: &quot;lesion&quot; =&gt; finding; TARGET: &quot;anterior to the knee&quot; =&gt; finding site
RELATION: SOURCE =&gt; has spatial orientation =&gt; TARGET
&quot;The mass is below the diaphragm.&quot;
SOURCE: &quot;mass&quot; =&gt; finding; TARGET: &quot;below the diaphragm&quot; =&gt; finding site
RELATION: SOURCE =&gt; has spatial orientation =&gt; TARGET
&quot;The opacity is posterior to the heart.&quot;
SOURCE: &quot;opacity&quot; =&gt; finding; TARGET: &quot;posterior to the heart&quot; =&gt; finding site
RELATION: SOURCE =&gt; has spatial orientation =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has spatial orientation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000073 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000073">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000112"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>Right-sided pneumothorax; bilateral knee pain.</obo:IAO_0000112>
        <obo:IAO_0000115>A finding association specifying the laterality (left, right, bilateral, unilateral, or midline) of a finding relative to a body site.</obo:IAO_0000115>
        <obo:IAO_0000232>laterality_qualifier
  ⊑ has_participant_qualifier only
     (PATO:0000611  # left
      or PATO:0000612  # right
      or PATO:0000613  # bilateral
      or PATO:0000614  # unilateral
      or PATO:0000610) # midline</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:272741003</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000073</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;left&quot; =&gt; has laterality
&quot;right-sided&quot; =&gt; has laterality
&quot;bilateral&quot; =&gt; has laterality

NEGATIVE EXAMPLES:
&quot;anterior&quot; =&gt; has spatial orientation, NOT has laterality
&quot;severe&quot; =&gt; has severity, NOT has laterality
&quot;intermittent&quot; =&gt; has course, NOT has laterality

CONTEXTUAL EXAMPLES:
&quot;The patient has left knee pain.&quot;
SOURCE: &quot;knee pain&quot; =&gt; finding; TARGET: &quot;left&quot; =&gt; laterality
RELATION: SOURCE =&gt; has laterality =&gt; TARGET
&quot;A right-sided pneumothorax was seen.&quot;
SOURCE: &quot;pneumothorax&quot; =&gt; finding; TARGET: &quot;right-sided&quot; =&gt; laterality
RELATION: SOURCE =&gt; has laterality =&gt; TARGET
&quot;She has bilateral knee pain.&quot;
SOURCE: &quot;knee pain&quot; =&gt; finding; TARGET: &quot;bilateral&quot; =&gt; laterality
RELATION: SOURCE =&gt; has laterality =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has laterality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000074 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000074">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000106"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <obo:IAO_0000112>Severe abdominal pain; mild hearing loss.</obo:IAO_0000112>
        <obo:IAO_0000115>A finding association specifying the severity or intensity of a finding or condition.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>HP:0012824</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT:246112005</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000074</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;severe&quot; =&gt; has severity
&quot;mild&quot; =&gt; has severity
&quot;moderate&quot; =&gt; has severity

NEGATIVE EXAMPLES:
&quot;worsening&quot; =&gt; has course, NOT has severity
&quot;left&quot; =&gt; has laterality, NOT has severity
&quot;for three weeks&quot; =&gt; has duration, NOT has severity

CONTEXTUAL EXAMPLES:
&quot;The patient has severe abdominal pain.&quot;
SOURCE: &quot;abdominal pain&quot; =&gt; finding; TARGET: &quot;severe&quot; =&gt; severity
RELATION: SOURCE =&gt; has severity =&gt; TARGET
&quot;She reports mild hearing loss.&quot;
SOURCE: &quot;hearing loss&quot; =&gt; finding; TARGET: &quot;mild&quot; =&gt; severity
RELATION: SOURCE =&gt; has severity =&gt; TARGET
&quot;He has moderate shortness of breath.&quot;
SOURCE: &quot;shortness of breath&quot; =&gt; finding; TARGET: &quot;moderate&quot; =&gt; severity
RELATION: SOURCE =&gt; has severity =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000075 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000075">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000024"/>
        <obo:IAO_0000112>Patient describes dizziness as a room spinning sensation.</obo:IAO_0000112>
        <obo:IAO_0000115>Information that qualitatively describes a finding, condition, or intervention.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0000075</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;room-spinning&quot; =&gt; has descriptive value
&quot;pressure-like&quot; =&gt; has descriptive value
&quot;nonproductive&quot; =&gt; has descriptive value

NEGATIVE EXAMPLES:
&quot;38.5 degrees Celsius&quot; =&gt; has quantifiable value, NOT has descriptive value
&quot;headache&quot; =&gt; finding, NOT has descriptive value
&quot;MRI&quot; =&gt; intervention, NOT has descriptive value

CONTEXTUAL EXAMPLES:
&quot;The patient described dizziness as room-spinning.&quot;
SOURCE: &quot;dizziness&quot; =&gt; finding; TARGET: &quot;room-spinning&quot; =&gt; value
RELATION: SOURCE =&gt; has descriptive value =&gt; TARGET
&quot;She described the pain as pressure-like.&quot;
SOURCE: &quot;pain&quot; =&gt; finding; TARGET: &quot;pressure-like&quot; =&gt; value
RELATION: SOURCE =&gt; has descriptive value =&gt; TARGET
&quot;The cough was nonproductive.&quot;
SOURCE: &quot;cough&quot; =&gt; finding; TARGET: &quot;nonproductive&quot; =&gt; value
RELATION: SOURCE =&gt; has descriptive value =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has descriptive value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000076 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000076">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000024"/>
        <obo:IAO_0000112>Blood pressure 130/80 mmHg; hemoglobin 10.2 g/dL.</obo:IAO_0000112>
        <obo:IAO_0000115>Information that numerically quantifies a finding, condition, or intervention.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>IAO:0000109</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000076</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;38.5 degrees Celsius&quot; =&gt; has quantifiable value
&quot;120/80 mmHg&quot; =&gt; has quantifiable value
&quot;10.2 g/dL&quot; =&gt; has quantifiable value

NEGATIVE EXAMPLES:
&quot;severe&quot; =&gt; has descriptive value or has severity, NOT has quantifiable value
&quot;fever&quot; =&gt; finding, NOT has quantifiable value
&quot;MRI&quot; =&gt; intervention, NOT has quantifiable value

CONTEXTUAL EXAMPLES:
&quot;The temperature was 38.5 degrees Celsius.&quot;
SOURCE: &quot;temperature&quot; =&gt; finding; TARGET: &quot;38.5 degrees Celsius&quot; =&gt; value
RELATION: SOURCE =&gt; has quantifiable value =&gt; TARGET
&quot;Blood pressure was 120/80 mmHg.&quot;
SOURCE: &quot;blood pressure&quot; =&gt; finding; TARGET: &quot;120/80 mmHg&quot; =&gt; value
RELATION: SOURCE =&gt; has quantifiable value =&gt; TARGET
&quot;Hemoglobin was 10.2 g/dL.&quot;
SOURCE: &quot;hemoglobin&quot; =&gt; finding; TARGET: &quot;10.2 g/dL&quot; =&gt; value
RELATION: SOURCE =&gt; has quantifiable value =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has quantifiable value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000077 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000077">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000101"/>
        <rdfs:domain>
            <owl:Class>
                                    <owl:unionOf rdf:parseType="Collection">
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                                        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000111"/>
                                    </owl:unionOf>
                                </owl:Class>
        </rdfs:domain>
        <obo:IAO_0000112>The pink sputum suggests hemoptysis.</obo:IAO_0000112>
        <obo:IAO_0000115>A finding or condition suggested by a diagnostic process, documentation, another finding or condition, or an intervention.</obo:IAO_0000115>
        <oboInOwl:id>CLCO:0000077</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;imaging suggested pneumonia&quot; =&gt; suggests finding
&quot;the note raised concern for malignancy&quot; =&gt; suggests finding
&quot;the symptom pattern pointed to appendicitis&quot; =&gt; suggests finding

NEGATIVE EXAMPLES:
&quot;imaging confirmed pneumonia&quot; =&gt; is consistent with diagnosis, NOT suggests finding
&quot;the patient denied pneumonia&quot; =&gt; negation, NOT suggests finding
&quot;MRI was ordered for headache&quot; =&gt; has reason, NOT suggests finding

CONTEXTUAL EXAMPLES:
&quot;The chest x-ray suggested pneumonia.&quot;
SOURCE: &quot;chest x-ray&quot; =&gt; intervention; TARGET: &quot;pneumonia&quot; =&gt; finding
RELATION: SOURCE =&gt; suggests finding =&gt; TARGET
&quot;The note raised concern for malignancy.&quot;
SOURCE: &quot;note&quot; =&gt; documentation; TARGET: &quot;malignancy&quot; =&gt; finding
RELATION: SOURCE =&gt; suggests finding =&gt; TARGET
&quot;The symptom pattern pointed to appendicitis.&quot;
SOURCE: &quot;symptom pattern&quot; =&gt; finding; TARGET: &quot;appendicitis&quot; =&gt; finding
RELATION: SOURCE =&gt; suggests finding =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>suggests finding</rdfs:label>
    </owl:ObjectProperty>
    


    


    


    


    


    


    


    


    


    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000115>A core clinical entity over which all clinical context associations occur.</obo:IAO_0000115>
        <obo:IAO_0000232>The 14 core clinical entity classes defined in:
Colicchio, Tiago K., Pavithra I. Dissanayake, and James J. Cimino. &quot;Formal representation of patients’ care context data: the path to improving the electronic health record.&quot; Journal of the American Medical Informatics Association 27, no. 11 (2020): 1648-1657.
All of these should correspond to a subject or object in relations extracted by NLP systems. The exception to that is patient which may be inferred.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000100</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES: patient, chest pain, and appendectomy are clinical entities.
NEGATIVE EXAMPLES: has, severely, and because are a relation, modifier, and conjunction rather than clinical entities.
CONTEXTUAL EXAMPLES: In &quot;The patient has chest pain&quot;, patient and chest pain are clinical entities; in &quot;Appendectomy was scheduled&quot;, appendectomy is a clinical entity.</obo:IAO_0000112>
        <rdfs:label>clinical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>A clinical finding of any type, including conditions, diagnosis and assessments.</obo:IAO_0000115>
        <obo:IAO_0000232>Was finding/condition in original paper, can treat condition as a subclass if needed.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:404684003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>biolink:DiseaseOrPhenotypicFeature</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000101</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding
&quot;Fever&quot; =&gt; finding
&quot;Headache&quot; =&gt; finding
&quot;Muscle weakness&quot; =&gt; finding
&quot;Shortness of breath&quot; =&gt; finding


NEGATIVE EXAMPLES:
&quot;MRI&quot; =&gt; intervention, NOT finding
&quot;Biopsy&quot; =&gt; intervention, NOT finding
&quot;Physician&quot; =&gt; clinician, NOT finding
&quot;Mother&quot; =&gt; family member, NOT finding
&quot;Three weeks&quot; =&gt; duration, NOT finding
&quot;Worsening&quot; =&gt; course, NOT finding
&quot;Severe&quot; =&gt; severity, NOT finding
&quot;Suspected&quot; =&gt; uncertainty, NOT finding


CONTEXTUAL EXAMPLES:
&quot;The patient presented with severe chest pain.&quot;
Annotate: &quot;chest pain&quot; =&gt; finding
Annotate: &quot;severe&quot; =&gt; severity

&quot;The patient reported progressively worsening muscle weakness.&quot;
Annotate: &quot;muscle weakness&quot; =&gt; finding
Annotate: &quot;progressively worsening&quot; =&gt; course

&quot;MRI revealed a pulmonary nodule.&quot;
Annotate: &quot;pulmonary nodule&quot; =&gt; finding
Annotate: &quot;MRI&quot; =&gt; intervention

&quot;The patient experienced intermittent headaches for three weeks.&quot;
Annotate: &quot;headaches&quot; =&gt; finding
Annotate: &quot;intermittent&quot; =&gt; course
Annotate: &quot;three weeks&quot; =&gt; duration</obo:IAO_0000112>
        <rdfs:label>finding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>An intervention to treat or diagnose a finding/condition or the patient</obo:IAO_0000115>
        <obo:IAO_0000232>There is not a SNOMED code for this as of 08/19/2026 documented in the athena ohdsi database.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>biolink:Procedure</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000102</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;MRI&quot; =&gt; intervention
&quot;Biopsy&quot; =&gt; intervention
&quot;Surgery&quot; =&gt; intervention
&quot;Antibiotic treatment&quot; =&gt; intervention

NEGATIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding, NOT intervention
&quot;Physician&quot; =&gt; clinician, NOT intervention
&quot;Three weeks&quot; =&gt; time, NOT intervention
&quot;Hospital&quot; =&gt; setting, NOT intervention

CONTEXTUAL EXAMPLES:
&quot;The patient underwent an MRI.&quot;
Annotate: &quot;MRI&quot; =&gt; intervention

&quot;A biopsy was performed to evaluate the mass.&quot;
Annotate: &quot;biopsy&quot; =&gt; intervention
Annotate: &quot;mass&quot; =&gt; finding

&quot;The patient started antibiotic treatment for pneumonia.&quot;
Annotate: &quot;antibiotic treatment&quot; =&gt; intervention
Annotate: &quot;pneumonia&quot; =&gt; finding</obo:IAO_0000112>
        <rdfs:label>intervention</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Numerical or narrative temporal data elements</obo:IAO_0000115>
        <obo:IAO_0000232>Moved from subClassOf task (CLCO_0000109) to subClassOf clinical_entity (CLCO_0000100). Time is a first-class clinical entity type, not a subtype of task.</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:410669006</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000103</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Three weeks&quot; =&gt; time
&quot;Yesterday&quot; =&gt; time
&quot;Since childhood&quot; =&gt; time
&quot;For two months&quot; =&gt; time

NEGATIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding, NOT time
&quot;Worsening&quot; =&gt; course, NOT time
&quot;Severe&quot; =&gt; severity, NOT time
&quot;MRI&quot; =&gt; intervention, NOT time

CONTEXTUAL EXAMPLES:
&quot;The patient has had headaches for three weeks.&quot;
Annotate: &quot;headaches&quot; =&gt; finding
Annotate: &quot;three weeks&quot; =&gt; time

&quot;The symptoms began yesterday.&quot;
Annotate: &quot;symptoms&quot; =&gt; finding
Annotate: &quot;yesterday&quot; =&gt; time

&quot;The patient has experienced pain since childhood.&quot;
Annotate: &quot;pain&quot; =&gt; finding
Annotate: &quot;since childhood&quot; =&gt; time</obo:IAO_0000112>
        <rdfs:label>time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Justifications and reasons for ordering, performing, planning, or discontinuing an intervention or diagnostic process</obo:IAO_0000115>
        <obo:IAO_0000232>SNOMEDCT sourced from Athena OHDSI &quot;Reason and justification&quot; (https://athena.ohdsi.org/search-terms/terms/4128496)</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:288830005</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000104</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Because of worsening pain&quot; =&gt; reason
&quot;History of diabetes&quot; =&gt; reason
&quot;Abnormal imaging result&quot; =&gt; reason
&quot;Patient preference&quot; =&gt; reason

NEGATIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding, NOT reason
&quot;MRI&quot; =&gt; intervention, NOT reason
&quot;Physician&quot; =&gt; clinician, NOT reason
&quot;Three weeks&quot; =&gt; time, NOT reason

CONTEXTUAL EXAMPLES:
&quot;The MRI was ordered because of persistent headaches.&quot;
Annotate: &quot;MRI&quot; =&gt; intervention
Annotate: &quot;persistent headaches&quot; =&gt; finding
Annotate: &quot;because of persistent headaches&quot; =&gt; reason

&quot;Surgery was postponed due to the patient&apos;s cardiac risk.&quot;
Annotate: &quot;surgery&quot; =&gt; intervention
Annotate: &quot;cardiac risk&quot; =&gt; reason</obo:IAO_0000112>
        <rdfs:label>reason</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Course of a finding/condition. More specifically referring to the trends and changes in the progression of a disease.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT:260908002</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000105</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Stable&quot; =&gt; course
&quot;Worsening&quot; =&gt; course
&quot;Intermittent&quot; =&gt; course
&quot;Rapidly progressing&quot; =&gt; course

NEGATIVE EXAMPLES:
&quot;Two weeks&quot; =&gt; duration, not course
&quot;sudden onset&quot; =&gt; timing, not course


CONTEXTUAL EXAMPLES:
&quot;The patient reported progressively worsening weakness.&quot;
Annotate: &quot;progressively worsening&quot; =&gt; course
Annotate: &quot;weakness&quot; =&gt; finding

&quot;The patient&apos;s symptoms have remained stable.&quot;
Annotate: &quot;stable&quot; =&gt; course

&quot;The patient experienced intermittent episodes of chest pain.&quot;
Annotate: &quot;intermittent&quot; =&gt; course</obo:IAO_0000112>
        <rdfs:label>course</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Any numerical or narrative description of a finding/condition or intervention</obo:IAO_0000115>
        <obo:IAO_0000232>SNOWMEDCT code for &quot;hasvalue&quot; sourced from Athena OHDSI database (https://athena.ohdsi.org/search-terms/terms/4306768)</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOWMEDCT:83568003</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000106</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;38.5 degrees Celsius&quot; =&gt; value
&quot;120/80 mmHg&quot; =&gt; value
&quot;Positive&quot; =&gt; value
&quot;No improvement&quot; =&gt; value

NEGATIVE EXAMPLES:
&quot;Fever&quot; =&gt; finding, NOT value
&quot;Severe&quot; =&gt; severity, NOT value
&quot;MRI&quot; =&gt; intervention, NOT value
&quot;Three weeks&quot; =&gt; time, NOT value

CONTEXTUAL EXAMPLES:
&quot;The patient&apos;s temperature was 38.5 degrees Celsius.&quot;
Annotate: &quot;temperature&quot; =&gt; finding
Annotate: &quot;38.5 degrees Celsius&quot; =&gt; value

&quot;The CT result was positive for pneumonia.&quot;
Annotate: &quot;CT&quot; =&gt; intervention
Annotate: &quot;positive&quot; =&gt; value
Annotate: &quot;pneumonia&quot; =&gt; finding</obo:IAO_0000112>
        <rdfs:label>value</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Health care setting or location</obo:IAO_0000115>
        <obo:IAO_0000232>There is not a SNOMED code for this as of 08/19/2026 documented in the athena ohdsi database.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000107</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Emergency department&quot; =&gt; setting
&quot;Intensive care unit&quot; =&gt; setting
&quot;Outpatient clinic&quot; =&gt; setting
&quot;Home&quot; =&gt; setting

NEGATIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding, NOT setting
&quot;Physician&quot; =&gt; clinician, NOT setting
&quot;MRI&quot; =&gt; intervention, NOT setting
&quot;Three weeks&quot; =&gt; time, NOT setting

CONTEXTUAL EXAMPLES:
&quot;The patient was admitted to the intensive care unit.&quot;
Annotate: &quot;patient&quot; =&gt; patient
Annotate: &quot;intensive care unit&quot; =&gt; setting

&quot;The procedure was performed in the outpatient clinic.&quot;
Annotate: &quot;procedure&quot; =&gt; intervention
Annotate: &quot;outpatient clinic&quot; =&gt; setting</obo:IAO_0000112>
        <rdfs:label>setting</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Health care professional, unlike SNOMED, includes only people working directly with patients such as physicians, nurses, etc... Administrative healthcare professionals such as healthcare billing coders are not included.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT:44804106</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000108</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Physician&quot; =&gt; clinician
&quot;Nurse practitioner&quot; =&gt; clinician
&quot;Physician assistant&quot; =&gt; clinician
&quot;Radiologist&quot; =&gt; clinician
&quot;Pathologist&quot; =&gt; clinician
&quot;Pharmacist&quot; =&gt; clinician

NEGATIVE EXAMPLES:
&quot;Mother&quot; =&gt; family member, NOT clinician
&quot;MRI&quot; =&gt; intervention, NOT clinician
&quot;30-year-old male patient&quot; =&gt; patient, NOT clinician</obo:IAO_0000112>
        <rdfs:label>clinician</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Any healthcare related task not related to direct clinical activities (e.g., phone call or uploading a medical record file).</obo:IAO_0000115>
        <obo:IAO_0000232>SNOMEDCT code sourced from Athena OHDSI &quot;TASK&quot; (https://athena.ohdsi.org/search-terms/terms/4008963)</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:101878003</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000109</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Phone call&quot; =&gt; task
&quot;Uploading a medical record&quot; =&gt; task
&quot;Scheduling an appointment&quot; =&gt; task
&quot;Reviewing the chart&quot; =&gt; task

NEGATIVE EXAMPLES:
&quot;MRI&quot; =&gt; intervention, NOT task
&quot;Chest pain&quot; =&gt; finding, NOT task
&quot;Physician&quot; =&gt; clinician, NOT task
&quot;Emergency department&quot; =&gt; setting, NOT task

CONTEXTUAL EXAMPLES:
&quot;The nurse called the patient to confirm the appointment.&quot;
Annotate: &quot;nurse&quot; =&gt; clinician
Annotate: &quot;called the patient&quot; =&gt; task

&quot;The staff uploaded the medical record to the portal.&quot;
Annotate: &quot;uploaded the medical record&quot; =&gt; task
Annotate: &quot;medical record&quot; =&gt; documentation</obo:IAO_0000112>
        <rdfs:label>task</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>The patient entity</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT:116154003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>biolink:Case</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000110</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;The patient&quot; =&gt; patient
&quot;The 30-year-old man&quot; =&gt; patient
&quot;The child&quot; =&gt; patient
&quot;She&quot; =&gt; patient, when the clinical note clearly identifies the referent as the patient

NEGATIVE EXAMPLES:
&quot;Physician&quot; =&gt; clinician, NOT patient
&quot;Mother&quot; =&gt; family member, NOT patient
&quot;Chest pain&quot; =&gt; finding, NOT patient
&quot;MRI&quot; =&gt; intervention, NOT patient

CONTEXTUAL EXAMPLES:
&quot;The patient reported chest pain.&quot;
Annotate: &quot;patient&quot; =&gt; patient
Annotate: &quot;chest pain&quot; =&gt; finding

&quot;She underwent surgery for a fractured femur.&quot;
Annotate: &quot;She&quot; =&gt; patient
Annotate: &quot;surgery&quot; =&gt; intervention
Annotate: &quot;fractured femur&quot; =&gt; finding</obo:IAO_0000112>
        <rdfs:label>patient</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Clinical documentation, e.g., progress notes, imaging reports</obo:IAO_0000115>
        <oboInOwl:hasDbXref>IAO:0000310</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000111</oboInOwl:id>
        <obo:IAO_0000112></obo:IAO_0000112>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Medical Record&quot; =&gt; documentation
&quot;Discharge summary&quot; =&gt; documentation
&quot;Patient chart&quot; =&gt; documentation
&quot;Clinical note&quot; =&gt; documentation

NEGATIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding, NOT documentation
&quot;MRI&quot; =&gt; intervention, NOT documentation
&quot;Three weeks&quot; =&gt; duration, NOT documentation
&quot;Physician&quot; =&gt; clinician, NOT documentation
&quot;Worsening&quot; =&gt; course, NOT documentation

CONTEXTUAL EXAMPLES:

&quot;The medical record noted a history of hypertension.&quot;
Annotate: &quot;medical record&quot; =&gt; documentation
Annotate: &quot;hypertension&quot; =&gt; finding

&quot;According to the clinical notes, the patient underwent surgery.&quot;
Annotate: According to the &quot;clinical notes&quot; =&gt; documentation
Annotate: &quot;surgery&quot; =&gt; intervention</obo:IAO_0000112>
        <rdfs:label>documentation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Anatomical site of a finding/condition</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMED:123037004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UBERON:0001062</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000112</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Chest&quot; =&gt; finding site
&quot;Cervical spine&quot; =&gt; finding site
&quot;Pituitary&quot; =&gt; finding site
&quot;Ovary&quot; =&gt; finding site

NEGATIVE EXAMPLES:
&quot;Chest pain&quot; =&gt; finding, NOT finding site as a whole
&quot;Headache&quot; =&gt; finding, NOT finding site
&quot;Swelling&quot; =&gt; finding, NOT finding site
&quot;MRI&quot; =&gt; intervention, NOT finding site

CONTEXTUAL EXAMPLES:

&quot;The patient reported pain in the left knee.&quot;
Annotate: &quot;pain&quot; =&gt; finding
Annotate: &quot;left knee&quot; =&gt; finding site

&quot;The patient presented with swelling of the right ankle.&quot;
Annotate: &quot;swelling&quot; =&gt; finding
Annotate: &quot;right ankle&quot; =&gt; finding site

&quot;CT revealed a mass in the left lung.&quot;
Annotate: &quot;mass&quot; =&gt; finding
Annotate: &quot;left lung&quot; =&gt; finding site
Annotate: &quot;CT&quot; =&gt; intervention

&quot;The patient experienced tenderness over the lower abdomen.&quot;
Annotate: &quot;tenderness&quot; =&gt; finding
Annotate: &quot;lower abdomen&quot; =&gt; finding site

&quot;The patient had a fracture of the left femur.&quot;
Annotate: &quot;fracture&quot; =&gt; finding
Annotate: &quot;left femur&quot; =&gt; finding site

&quot;MRI demonstrated a lesion in the right temporal lobe.&quot;
Annotate: &quot;lesion&quot; =&gt; finding
Annotate: &quot;right temporal lobe&quot; =&gt; finding site
Annotate: &quot;MRI&quot; =&gt; intervention</obo:IAO_0000112>
        <rdfs:label>finding site</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>Patient state, e.g., stable, improving. The overall patient state, not whether a particular disease or condition is stable or improving.</obo:IAO_0000115>
        <obo:IAO_0000232>SNOMEDCT was sourced from Athena OHDSI &quot;Patient Status&quot; (http://athena.ohdsi.org/search-terms/terms/4077556)</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOWMEDCT:246097001</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000113</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Stable&quot; =&gt; patient state
&quot;Improving&quot; =&gt; patient state
&quot;Unstable&quot; =&gt; patient state
&quot;Alert and oriented&quot; =&gt; patient state

NEGATIVE EXAMPLES:
&quot;Stable disease&quot; =&gt; course, NOT patient state
&quot;Chest pain&quot; =&gt; finding, NOT patient state
&quot;Physician&quot; =&gt; clinician, NOT patient state
&quot;Three weeks&quot; =&gt; time, NOT patient state

CONTEXTUAL EXAMPLES:
&quot;The patient is clinically stable.&quot;
Annotate: &quot;patient&quot; =&gt; patient
Annotate: &quot;clinically stable&quot; =&gt; patient state

&quot;The patient is improving after treatment.&quot;
Annotate: &quot;patient&quot; =&gt; patient
Annotate: &quot;improving&quot; =&gt; patient state
Annotate: &quot;treatment&quot; =&gt; intervention

&quot;The patient&apos;s symptoms are stable.&quot;
Annotate: &quot;symptoms&quot; =&gt; finding
Annotate: &quot;stable&quot; =&gt; course</obo:IAO_0000112>
        <rdfs:label>patient state</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000114 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CLCO_0000114">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000058"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000110"/>
        <obo:IAO_0000112>Patient discharged this morning with family</obo:IAO_0000112>
        <obo:IAO_0000112>Patient will be discharged</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that the patient has been discharged from a clinical setting</obo:IAO_0000115>
        <oboInOwl:hasDbXref>OMOP_CONCEPT_ID:4137031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMED:58000006</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000114</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;discharged home&quot; =&gt; is discharged
&quot;discharged from the hospital&quot; =&gt; is discharged
&quot;ready for discharge&quot; =&gt; is discharged

NEGATIVE EXAMPLES:
&quot;admitted to the hospital&quot; =&gt; is admitted, NOT is discharged
&quot;transferred to rehabilitation&quot; =&gt; is transferred to, NOT is discharged
&quot;referred to cardiology&quot; =&gt; is referred by, NOT is discharged

CONTEXTUAL EXAMPLES:
&quot;The patient was discharged home.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;home&quot; =&gt; setting
RELATION: SOURCE =&gt; is discharged =&gt; TARGET
&quot;She was discharged from the hospital.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;hospital&quot; =&gt; setting
RELATION: SOURCE =&gt; is discharged =&gt; TARGET
&quot;He is ready for discharge.&quot;
SOURCE: &quot;patient&quot; =&gt; patient; TARGET: &quot;discharge&quot; =&gt; clinical administration
RELATION: SOURCE =&gt; is discharged =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>is discharged</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000100"/>
        <obo:IAO_0000115>A person who is a member of the patient&apos;s family. A caregiver who is not a family member would be identified as a clinician.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMED:303071001</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000115</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;Mother&quot; =&gt; family member
&quot;Father&quot; =&gt; family member
&quot;Sister&quot; =&gt; family member
&quot;Brother&quot; =&gt; family member
&quot;Daughter&quot; =&gt; family member

NEGATIVE EXAMPLES:
&quot;Patient&quot; =&gt; patient, NOT family member
&quot;Physician&quot; =&gt; clinician, NOT family member
&quot;Nurse practitioner&quot; =&gt; clinician, NOT family member


CONTEXTUAL EXAMPLES:
&quot;The patient&apos;s mother has a history of breast cancer.&quot;
Annotate: &quot;mother&quot; =&gt; family member
Annotate: &quot;breast cancer&quot; =&gt; finding

&quot;His father was diagnosed with diabetes.&quot;
Annotate: &quot;father&quot; =&gt; family member
Annotate: &quot;diabetes&quot; =&gt; finding

&quot;The patient&apos;s sister reported similar symptoms.&quot;
Annotate: &quot;sister&quot; =&gt; family member</obo:IAO_0000112>
        <rdfs:label>family member</rdfs:label>
    </owl:Class>
    


    


    <!-- http://purl.obolibrary.org/obo/clco.owl#has_family_history -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/clco.owl#has_family_history">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000083"/>
        <obo:IAO_0000112>The patient&apos;s mother has a past medical history of hypercholoesterolemia.</obo:IAO_0000112>
        <obo:IAO_0000115>History of chronic illness in family members</obo:IAO_0000115>
        <obo:IAO_0000232>Sourced from Athena OHDSI &quot;family history&quot; (https://athena.ohdsi.org/search-terms/terms/40306697)</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:137667000</oboInOwl:hasDbXref>
        <obo:IAO_0000112>POSITIVE EXAMPLES: &quot;mother had diabetes&quot;, &quot;sister with breast cancer&quot;, and &quot;father had a myocardial infarction&quot; express family history.
NEGATIVE EXAMPLES: &quot;patient has diabetes&quot; is has finding; &quot;mother is at home&quot; is has setting; &quot;family discussed surgery&quot; is discussed with.
CONTEXTUAL EXAMPLES: In each positive example, SOURCE is the patient and TARGET is the affected family member or familial finding, with RELATION has family history.</obo:IAO_0000112>
        <rdfs:label>has family history</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/clco.owl#has_timing -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/clco.owl#has_timing">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000057"/>
        <obo:IAO_0000112>Patient explains that her significant pelvic discomfort occurs 2-3 days a month concurrent with the onset of menstruation for the past 4 months.</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicates the reccurence/or frequency of a finding/condition/intervention with a specific time of day or month.</obo:IAO_0000115>
        <obo:IAO_0000232>SNOMEDCT sourced from Athena OHDSI (https://athena.ohdsi.org/search-terms/terms/4079053)</obo:IAO_0000232>
        <oboInOwl:hasDbXref>SNOMEDCT:246512002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>This class also encompases the prior has frequency class that was provided in earlier versions of clco-edit.owl. SNOMED 162451001 is symptom frequency, break this down into intervention and condition/symptom/finding frequency.</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>biolink:frequency_qualifier</oboInOwl:hasDbXref>
        <oboInOwl:id>CLCO:0000019</oboInOwl:id>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;twice daily&quot; =&gt; has timing
&quot;every morning&quot; =&gt; has timing
&quot;monthly&quot; =&gt; has timing

NEGATIVE EXAMPLES:
&quot;for three weeks&quot; =&gt; has duration, NOT has timing
&quot;last year&quot; =&gt; has date or temporal frame, NOT has timing
&quot;worsening&quot; =&gt; has course, NOT has timing

CONTEXTUAL EXAMPLES:
&quot;The pain occurs twice daily.&quot;
SOURCE: &quot;pain&quot; =&gt; finding; TARGET: &quot;twice daily&quot; =&gt; time
RELATION: SOURCE =&gt; has timing =&gt; TARGET
&quot;She takes the medication every morning.&quot;
SOURCE: &quot;medication&quot; =&gt; intervention; TARGET: &quot;every morning&quot; =&gt; time
RELATION: SOURCE =&gt; has timing =&gt; TARGET
&quot;The symptoms recur monthly.&quot;
SOURCE: &quot;symptoms&quot; =&gt; finding; TARGET: &quot;monthly&quot; =&gt; time
RELATION: SOURCE =&gt; has timing =&gt; TARGET</obo:IAO_0000112>
        <rdfs:label>has timing</rdfs:label>
    </owl:ObjectProperty>
    


